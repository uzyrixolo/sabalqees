{% doc %}
  @prompt
    a two column section. on left heading and below it text. and on right honey comb looking image like 4 hexagons like option to enable like 2 hexagons 3 hexagons whatever. hexagons will be like arranged in a line attaching each other. like first then other on top right side attached to it then the next below right side attached like that. make everything fully customisable, hexagons will be in a row horizontally, hexagons will be like arranged in a horizontal line attaching each other. like first then other on top right side attached to it then the next below right side attached like that.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-honeycomb-section-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.padding_top }}px 0 {{ block.settings.padding_bottom }}px;
  }

  .ai-honeycomb-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-honeycomb-wrapper-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.column_gap }}px;
    align-items: center;
  }

  .ai-honeycomb-content-{{ ai_gen_id }} {
    flex: 1;
  }

  .ai-honeycomb-heading-{{ ai_gen_id }} {
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
    margin: 0 0 {{ block.settings.heading_spacing }}px;
    line-height: 1.3;
  }

  .ai-honeycomb-text-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.text_size }}px;
    line-height: 1.6;
    margin: 0;
  }

  .ai-honeycomb-images-{{ ai_gen_id }} {
    flex: 1;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .ai-honeycomb-grid-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    position: relative;
  }

  .ai-honeycomb-hexagon-{{ ai_gen_id }} {
    width: {{ block.settings.hexagon_size }}px;
    height: {{ block.settings.hexagon_size | times: 1.15 }}px;
    position: relative;
    clip-path: polygon(50% 0%, 100% 25%, 100% 75%, 50% 100%, 0% 75%, 0% 25%);
    overflow: hidden;
    background-color: {{ block.settings.hexagon_bg_color }};
  }

  .ai-honeycomb-hexagon-{{ ai_gen_id }}:nth-child(1) {
    position: relative;
    z-index: 4;
  }

  .ai-honeycomb-hexagon-{{ ai_gen_id }}:nth-child(2) {
    position: relative;
    margin-left: calc(-{{ block.settings.hexagon_size }}px * 0.25);
    margin-top: calc(-{{ block.settings.hexagon_size }}px * 0.29);
    z-index: 3;
  }

  .ai-honeycomb-hexagon-{{ ai_gen_id }}:nth-child(3) {
    position: relative;
    margin-left: calc(-{{ block.settings.hexagon_size }}px * 0.25);
    margin-top: calc({{ block.settings.hexagon_size }}px * 0.29);
    z-index: 2;
  }

  .ai-honeycomb-hexagon-{{ ai_gen_id }}:nth-child(4) {
    position: relative;
    margin-left: calc(-{{ block.settings.hexagon_size }}px * 0.25);
    margin-top: calc(-{{ block.settings.hexagon_size }}px * 0.29);
    z-index: 1;
  }

  .ai-honeycomb-hexagon-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-honeycomb-hexagon-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #f4f4f4;
  }

  .ai-honeycomb-hexagon-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  @media screen and (max-width: 768px) {
    .ai-honeycomb-wrapper-{{ ai_gen_id }} {
      flex-direction: column;
      gap: 40px;
    }

    .ai-honeycomb-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.7 }}px;
    }

    .ai-honeycomb-text-{{ ai_gen_id }} {
      font-size: {{ block.settings.text_size | times: 0.9 }}px;
    }

    .ai-honeycomb-hexagon-{{ ai_gen_id }} {
      width: {{ block.settings.hexagon_size | times: 0.6 }}px;
      height: {{ block.settings.hexagon_size | times: 0.6 | times: 1.15 }}px;
    }

    .ai-honeycomb-hexagon-{{ ai_gen_id }}:nth-child(2) {
      margin-left: calc(-{{ block.settings.hexagon_size | times: 0.6 }}px * 0.25);
      margin-top: calc(-{{ block.settings.hexagon_size | times: 0.6 }}px * 0.29);
    }

    .ai-honeycomb-hexagon-{{ ai_gen_id }}:nth-child(3) {
      margin-left: calc(-{{ block.settings.hexagon_size | times: 0.6 }}px * 0.25);
      margin-top: calc({{ block.settings.hexagon_size | times: 0.6 }}px * 0.29);
    }

    .ai-honeycomb-hexagon-{{ ai_gen_id }}:nth-child(4) {
      margin-left: calc(-{{ block.settings.hexagon_size | times: 0.6 }}px * 0.25);
      margin-top: calc(-{{ block.settings.hexagon_size | times: 0.6 }}px * 0.29);
    }
  }
{% endstyle %}

<ai-honeycomb-section-{{ ai_gen_id }} class="ai-honeycomb-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-honeycomb-container-{{ ai_gen_id }}">
    <div class="ai-honeycomb-wrapper-{{ ai_gen_id }}">
      <div class="ai-honeycomb-content-{{ ai_gen_id }}">
        {% if block.settings.heading != blank %}
          <h2 class="ai-honeycomb-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
        {% endif %}
        {% if block.settings.text != blank %}
          <div class="ai-honeycomb-text-{{ ai_gen_id }}">{{ block.settings.text }}</div>
        {% endif %}
      </div>

      <div class="ai-honeycomb-images-{{ ai_gen_id }}">
        <div class="ai-honeycomb-grid-{{ ai_gen_id }}">
          <div class="ai-honeycomb-hexagon-{{ ai_gen_id }}">
            {% if block.settings.image_1 %}
              <img src="{{ block.settings.image_1 | image_url: width: 400 }}" alt="{{ block.settings.image_1.alt | escape }}" loading="lazy">
            {% else %}
              <div class="ai-honeycomb-hexagon-placeholder-{{ ai_gen_id }}">
                {{ 'image' | placeholder_svg_tag }}
              </div>
            {% endif %}
          </div>

          {% if block.settings.hexagon_count >= 2 %}
            <div class="ai-honeycomb-hexagon-{{ ai_gen_id }}">
              {% if block.settings.image_2 %}
                <img src="{{ block.settings.image_2 | image_url: width: 400 }}" alt="{{ block.settings.image_2.alt | escape }}" loading="lazy">
              {% else %}
                <div class="ai-honeycomb-hexagon-placeholder-{{ ai_gen_id }}">
                  {{ 'image' | placeholder_svg_tag }}
                </div>
              {% endif %}
            </div>
          {% endif %}

          {% if block.settings.hexagon_count >= 3 %}
            <div class="ai-honeycomb-hexagon-{{ ai_gen_id }}">
              {% if block.settings.image_3 %}
                <img src="{{ block.settings.image_3 | image_url: width: 400 }}" alt="{{ block.settings.image_3.alt | escape }}" loading="lazy">
              {% else %}
                <div class="ai-honeycomb-hexagon-placeholder-{{ ai_gen_id }}">
                  {{ 'image' | placeholder_svg_tag }}
                </div>
              {% endif %}
            </div>
          {% endif %}

          {% if block.settings.hexagon_count >= 4 %}
            <div class="ai-honeycomb-hexagon-{{ ai_gen_id }}">
              {% if block.settings.image_4 %}
                <img src="{{ block.settings.image_4 | image_url: width: 400 }}" alt="{{ block.settings.image_4.alt | escape }}" loading="lazy">
              {% else %}
                <div class="ai-honeycomb-hexagon-placeholder-{{ ai_gen_id }}">
                  {{ 'image' | placeholder_svg_tag }}
                </div>
              {% endif %}
            </div>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</ai-honeycomb-section-{{ ai_gen_id }}>

<script>
  (function() {
    class AiHoneycombSection{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
      }
    }

    customElements.define('ai-honeycomb-section-{{ ai_gen_id }}', AiHoneycombSection{{ ai_gen_id }});
  })();
</script>

