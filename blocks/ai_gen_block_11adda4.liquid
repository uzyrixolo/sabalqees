{% doc %}
  @prompt
    main heading then below it. display all collections in circular media and below it its title. not all collections which will be selected. make everything fully customisable and on phone it will be carousel, option to add custom title and image.\
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-collections-showcase-{{ ai_gen_id }} {
    width: 100%;
    display: block;
    padding: 40px 20px;
  }

  .ai-collections-showcase__container-{{ ai_gen_id }} {
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
  }

  .ai-collections-showcase__heading-{{ ai_gen_id }} {
    text-align: {{ block.settings.heading_alignment }};
    margin: 0 0 {{ block.settings.heading_spacing }}px;
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
  }

  .ai-collections-showcase__grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, 1fr);
    gap: {{ block.settings.grid_gap }}px;
  }

  .ai-collections-showcase__item-{{ ai_gen_id }} {
    text-align: center;
  }

  .ai-collections-showcase__link-{{ ai_gen_id }} {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .ai-collections-showcase__image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding-bottom: 100%;
    margin-bottom: {{ block.settings.title_spacing }}px;
    overflow: hidden;
    border-radius: 50%;
    background-color: {{ block.settings.placeholder_bg_color }};
  }

  .ai-collections-showcase__image-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform {{ block.settings.hover_animation_duration }}s ease;
  }

  {% if block.settings.enable_hover_effect %}
    .ai-collections-showcase__link-{{ ai_gen_id }}:hover .ai-collections-showcase__image-{{ ai_gen_id }} {
      transform: scale({{ block.settings.hover_scale }});
    }
  {% endif %}

  .ai-collections-showcase__placeholder-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-collections-showcase__placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-collections-showcase__title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    margin: 0;
    transition: color {{ block.settings.hover_animation_duration }}s ease;
  }

  {% if block.settings.enable_hover_effect %}
    .ai-collections-showcase__link-{{ ai_gen_id }}:hover .ai-collections-showcase__title-{{ ai_gen_id }} {
      color: {{ block.settings.title_hover_color }};
    }
  {% endif %}

  @media screen and (max-width: 749px) {
    .ai-collections-showcase__grid-{{ ai_gen_id }} {
      display: none;
    }

    .ai-collections-showcase__carousel-{{ ai_gen_id }} {
      display: block;
      position: relative;
      overflow: hidden;
    }

    .ai-collections-showcase__carousel-track-{{ ai_gen_id }} {
      display: flex;
      gap: {{ block.settings.grid_gap }}px;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      -ms-overflow-style: none;
      padding: 0 20px;
    }

    .ai-collections-showcase__carousel-track-{{ ai_gen_id }}::-webkit-scrollbar {
      display: none;
    }

    .ai-collections-showcase__carousel-item-{{ ai_gen_id }} {
      flex: 0 0 calc((100% - {{ block.settings.grid_gap }}px) / {{ block.settings.columns_mobile }});
      scroll-snap-align: start;
    }
.ai-collections-showcase__heading-{{ ai_gen_id }} {
  font-size: 36px;
}

.ai-collections-showcase__title-{{ ai_gen_id }} {
  font-size: {{ block.settings.title_size | times: 0.9 }}px;
  text-align: center;
}
  }

  @media screen and (min-width: 750px) {
    .ai-collections-showcase__carousel-{{ ai_gen_id }} {
      display: none;
    }
  }
{% endstyle %}

<collections-showcase-{{ ai_gen_id }}
  class="ai-collections-showcase-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-collections-showcase__container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <h2 class="ai-collections-showcase__heading-{{ ai_gen_id }}">
        {{ block.settings.heading }}
      </h2>
    {% endif %}

    <div class="ai-collections-showcase__grid-{{ ai_gen_id }}">
      {% for i in (1..8) %}
        {% liquid
          assign collection_key = 'collection_' | append: i
          assign custom_title_key = 'custom_title_' | append: i
          assign custom_image_key = 'custom_image_' | append: i
          assign custom_link_key = 'custom_link_' | append: i
          
          assign collection = block.settings[collection_key]
          assign custom_title = block.settings[custom_title_key]
          assign custom_image = block.settings[custom_image_key]
          assign custom_link = block.settings[custom_link_key]
          
          assign display_title = collection.title
          assign display_image = collection.image
          assign display_url = collection.url
          
          if custom_title != blank
            assign display_title = custom_title
          endif
          
          if custom_image != blank
            assign display_image = custom_image
          endif
          
          if custom_link != blank
            assign display_url = custom_link
          endif
        %}

        {% if collection != blank %}
          <div class="ai-collections-showcase__item-{{ ai_gen_id }}">
            <a
              href="{{ display_url }}"
              class="ai-collections-showcase__link-{{ ai_gen_id }}"
            >
              <div class="ai-collections-showcase__image-wrapper-{{ ai_gen_id }}">
                {% if display_image %}
                  <img
                    src="{{ display_image | image_url: width: 500 }}"
                    alt="{{ display_image.alt | default: display_title | escape }}"
                    class="ai-collections-showcase__image-{{ ai_gen_id }}"
                    loading="lazy"
                    width="500"
                    height="500"
                  >
                {% else %}
                  <div class="ai-collections-showcase__placeholder-{{ ai_gen_id }}">
                    {{ 'collection-1' | placeholder_svg_tag }}
                  </div>
                {% endif %}
              </div>
              <h3 class="ai-collections-showcase__title-{{ ai_gen_id }}">
                {{ display_title }}
              </h3>
            </a>
          </div>
        {% endif %}
      {% endfor %}
    </div>

    <div class="ai-collections-showcase__carousel-{{ ai_gen_id }}">
      <div class="ai-collections-showcase__carousel-track-{{ ai_gen_id }}">
        {% for i in (1..8) %}
          {% liquid
            assign collection_key = 'collection_' | append: i
            assign custom_title_key = 'custom_title_' | append: i
            assign custom_image_key = 'custom_image_' | append: i
            assign custom_link_key = 'custom_link_' | append: i
            
            assign collection = block.settings[collection_key]
            assign custom_title = block.settings[custom_title_key]
            assign custom_image = block.settings[custom_image_key]
            assign custom_link = block.settings[custom_link_key]
            
            assign display_title = collection.title
            assign display_image = collection.image
            assign display_url = collection.url
            
            if custom_title != blank
              assign display_title = custom_title
            endif
            
            if custom_image != blank
              assign display_image = custom_image
            endif
            
            if custom_link != blank
              assign display_url = custom_link
            endif
          %}

          {% if collection != blank %}
            <div class="ai-collections-showcase__carousel-item-{{ ai_gen_id }}">
              <a
                href="{{ display_url }}"
                class="ai-collections-showcase__link-{{ ai_gen_id }}"
              >
                <div class="ai-collections-showcase__image-wrapper-{{ ai_gen_id }}">
                  {% if display_image %}
                    <img
                      src="{{ display_image | image_url: width: 500 }}"
                      alt="{{ display_image.alt | default: display_title | escape }}"
                      class="ai-collections-showcase__image-{{ ai_gen_id }}"
                      loading="lazy"
                      width="500"
                      height="500"
                    >
                  {% else %}
                    <div class="ai-collections-showcase__placeholder-{{ ai_gen_id }}">
                      {{ 'collection-1' | placeholder_svg_tag }}
                    </div>
                  {% endif %}
                </div>
                <h3 class="ai-collections-showcase__title-{{ ai_gen_id }}">
                  {{ display_title }}
                </h3>
              </a>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>
</collections-showcase-{{ ai_gen_id }}>

