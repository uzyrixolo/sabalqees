{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-product-carousel-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    border-bottom: {{ block.settings.border_bottom_width }}px solid {{ block.settings.border_color }};
    padding-bottom: {{ block.settings.section_padding_bottom }}px;
    padding-top: {{ block.settings.section_padding_top }}px;
    max-width: 1320px;
    margin: 0 auto;
  }

  .ai-product-carousel-header-{{ ai_gen_id }} {
    text-align: {{ block.settings.heading_alignment }};
    margin-bottom: {{ block.settings.header_margin_bottom }}px;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin-left: auto;
    margin-right: auto;
  }

  .ai-product-carousel-main-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.main_heading_size }}px;
    color: {{ block.settings.main_heading_color }};
    font-weight: {{ block.settings.main_heading_weight }};
    margin: 0 0 {{ block.settings.main_heading_margin_bottom }}px 0;
  }

  .ai-product-carousel-sub-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.sub_heading_size }}px;
    color: {{ block.settings.sub_heading_color }};
    font-weight: {{ block.settings.sub_heading_weight }};
    margin: 0;
  }

  .ai-product-carousel-container-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.gap_between_sections }}px;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
  }

  .ai-product-carousel-products-{{ ai_gen_id }} {
    width: 75%;
    overflow: hidden;
    position: relative;
  }

  .ai-product-carousel-filters-{{ ai_gen_id }} {
    width: 25%;
    padding: {{ block.settings.filter_padding }}px;
  }

  .ai-product-carousel-filter-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.filter_heading_size }}px;
    color: {{ block.settings.filter_heading_color }};
    margin-bottom: {{ block.settings.filter_heading_margin_bottom }}px;
    border-bottom: {{ block.settings.filter_heading_underline_width }}px solid {{ block.settings.filter_heading_underline_color }};
    padding-bottom: {{ block.settings.filter_heading_padding_bottom }}px;
    font-weight: {{ block.settings.filter_heading_weight }};
  }

  .ai-product-carousel-filter-item-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    margin-bottom: {{ block.settings.filter_item_spacing }}px;
  }

  .ai-product-carousel-filter-checkbox-{{ ai_gen_id }} {
    width: {{ block.settings.checkbox_size }}px;
    height: {{ block.settings.checkbox_size }}px;
    margin-right: {{ block.settings.checkbox_margin_right }}px;
    cursor: pointer;
    accent-color: {{ block.settings.checkbox_color }};
  }

  .ai-product-carousel-filter-label-{{ ai_gen_id }} {
    font-size: {{ block.settings.filter_label_size }}px;
    color: {{ block.settings.filter_label_color }};
    cursor: pointer;
  }

  .ai-product-carousel-slider-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.product_gap }}px;
    transition: transform 0.5s ease;
  }

  .ai-product-carousel-slide-{{ ai_gen_id }} {
    flex: 0 0 calc((100% - ({{ block.settings.products_per_row | minus: 1 }} * {{ block.settings.product_gap }}px)) / {{ block.settings.products_per_row }});
    min-width: 0;
    display: flex;
    flex-direction: column;
  }

  .ai-product-carousel-card-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .ai-product-carousel-image-wrapper-{{ ai_gen_id }} {
    display: block;
    position: relative;
    width: 100%;
    padding-bottom: 100%;
    overflow: hidden;
    border-radius: {{ block.settings.image_border_radius }}px;
    margin-bottom: {{ block.settings.image_margin_bottom }}px;
  }

  .ai-product-carousel-image-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-product-carousel-placeholder-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-product-carousel-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
  }

  /* CUSTOM BADGE STYLES */
  .custom-metafield-badge-{{ ai_gen_id }} {
    position: absolute;
    top: 10px;
    right: 10px;
    z-index: 20;
    pointer-events: none;
  }

  .custom-metafield-badge-{{ ai_gen_id }} img {
    max-width: 45px;
    height: auto;
    display: block;
  }

  .ai-product-carousel-content-{{ ai_gen_id }} {
    flex: 1;
    display: flex;
    flex-direction: column;
    text-align: left;
  }

  .ai-product-carousel-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.product_title_size }}px;
    color: {{ block.settings.product_title_color }};
    margin-bottom: {{ block.settings.title_margin_bottom }}px;
    font-weight: {{ block.settings.product_title_weight }};
    text-align: left;
  }

  .ai-product-carousel-title-link-{{ ai_gen_id }} {
    text-decoration: none;
    color: inherit;
    transition: opacity 0.3s ease;
  }

  .ai-product-carousel-title-link-{{ ai_gen_id }}:hover {
    opacity: 0.8;
  }

  .ai-product-carousel-price-{{ ai_gen_id }} {
    font-size: {{ block.settings.product_price_size }}px;
    color: {{ block.settings.product_price_color }};
    margin-bottom: {{ block.settings.price_margin_bottom }}px;
    font-weight: {{ block.settings.product_price_weight }};
    text-align: left;
  }

  .ai-product-carousel-atc-{{ ai_gen_id }} {
    background-color: {{ block.settings.atc_bg_color }};
    color: {{ block.settings.atc_text_color }};
    border: none;
    padding: {{ block.settings.atc_padding_vertical }}px {{ block.settings.atc_padding_horizontal }}px;
    font-size: {{ block.settings.atc_font_size }}px;
    cursor: pointer;
    border-radius: {{ block.settings.atc_border_radius }}px;
    width: 100%;
    transition: background-color 0.3s ease;
    font-weight: {{ block.settings.atc_font_weight }};
    margin-top: auto;
  }

  .ai-product-carousel-atc-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.atc_bg_hover_color }};
    color: {{ block.settings.atc_text_hover_color }};
  }

  .ai-product-carousel-view-all-wrapper-{{ ai_gen_id }} {
    text-align: {{ block.settings.view_all_align }};
    margin-top: {{ block.settings.view_all_margin_top }}px;
  }

  .ai-product-carousel-view-all-{{ ai_gen_id }} {
    display: inline-block;
    background-color: {{ block.settings.view_all_bg_color }};
    color: {{ block.settings.view_all_text_color }};
    padding: {{ block.settings.view_all_padding_vertical }}px {{ block.settings.view_all_padding_horizontal }}px;
    text-decoration: none;
    border-radius: {{ block.settings.view_all_border_radius }}px;
    font-size: {{ block.settings.view_all_font_size }}px;
    transition: background-color 0.3s ease;
    font-weight: {{ block.settings.view_all_font_weight }};
  }

  .ai-product-carousel-view-all-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.view_all_bg_hover_color }};
    color: {{ block.settings.view_all_text_hover_color }};
  }

  @media screen and (max-width: 768px) {
    .ai-product-carousel-container-{{ ai_gen_id }} {
      flex-direction: column-reverse;
    }

    .ai-product-carousel-filters-{{ ai_gen_id }},
    .ai-product-carousel-products-{{ ai_gen_id }} {
      width: 100%;
    }

    .ai-product-carousel-slide-{{ ai_gen_id }} {
      flex: 0 0 calc((100% - {{ block.settings.product_gap }}px) / 2);
    }
    .ai-product-carousel-{{ ai_gen_id }}{
      padding-left: 20px;
      padding-right: 20px;
    }
    .ai-product-carousel-main-heading-{{ ai_gen_id }} {
      font-size: 36px;
    }
  }
{% endstyle %}

<product-carousel-{{ ai_gen_id }}
  class="ai-product-carousel-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
  data-autoplay="{{ block.settings.autoplay_enabled }}"
  data-autoplay-speed="{{ block.settings.autoplay_speed }}"
>
  {% if block.settings.main_heading != blank or block.settings.sub_heading != blank %}
    <div class="ai-product-carousel-header-{{ ai_gen_id }}">
      {% if block.settings.main_heading != blank %}
        <h2 class="ai-product-carousel-main-heading-{{ ai_gen_id }}">
          {{ block.settings.main_heading }}
        </h2>
      {% endif %}
      {% if block.settings.sub_heading != blank %}
        <p class="ai-product-carousel-sub-heading-{{ ai_gen_id }}">
          {{ block.settings.sub_heading }}
        </p>
      {% endif %}
    </div>
  {% endif %}

  <div class="ai-product-carousel-container-{{ ai_gen_id }}">
    <div class="ai-product-carousel-products-{{ ai_gen_id }}">
      <div class="ai-product-carousel-slider-{{ ai_gen_id }}">
        {% for product in block.settings.product_collection.products limit: block.settings.product_limit %}
          <div
            class="ai-product-carousel-slide-{{ ai_gen_id }}"
            data-health-goals='{{ product.metafields.custom.health_goals.value | json }}'
          >
            <div class="ai-product-carousel-card-{{ ai_gen_id }}">
              <a href="{{ product.url }}" class="ai-product-carousel-image-wrapper-{{ ai_gen_id }}">
                {% if product.featured_image %}
                  <img
                    src="{{ product.featured_image | image_url: width: 600 }}"
                    alt="{{ product.featured_image.alt | escape }}"
                    class="ai-product-carousel-image-{{ ai_gen_id }}"
                    loading="lazy"
                    width="600"
                    height="600"
                  >
                {% else %}
                  <div class="ai-product-carousel-placeholder-{{ ai_gen_id }}">
                    {{ 'product-1' | placeholder_svg_tag }}
                  </div>
                {% endif %}

                {%- comment -%} CUSTOM PRODUCT BADGE {%- endcomment -%}
                {%- if product.metafields.custom.product_badge != blank -%}
                  <div class="custom-metafield-badge-{{ ai_gen_id }}">
                    <img src="{{ product.metafields.custom.product_badge | image_url: width: 100 }}" alt="Product Badge" loading="lazy">
                  </div>
                {%- endif -%}

              </a>
              <div class="ai-product-carousel-content-{{ ai_gen_id }}">
                <h4 class="ai-product-carousel-title-{{ ai_gen_id }}">
                  <a href="{{ product.url }}" class="ai-product-carousel-title-link-{{ ai_gen_id }}">
                    {{ product.title }}
                  </a>
                </h4>
                <div class="ai-product-carousel-price-{{ ai_gen_id }}">
                  {{ product.price | money }}
                </div>
                <button
                  class="ai-product-carousel-atc-{{ ai_gen_id }}"
                  data-product-id="{{ product.id }}"
                  data-variant-id="{{ product.selected_or_first_available_variant.id }}"
                >
                  {{ block.settings.atc_button_text }}
                </button>
              </div>
            </div>
          </div>
        {% endfor %}
      </div>
    </div>

    <div class="ai-product-carousel-filters-{{ ai_gen_id }}">
      <h3 class="ai-product-carousel-filter-heading-{{ ai_gen_id }}">
        {{ block.settings.filter_heading }}
      </h3>
      <div class="ai-product-carousel-filter-list-{{ ai_gen_id }}">
        {% assign all_health_goals = '' %}
        {% for product in block.settings.product_collection.products %}
          {% if product.metafields.custom.health_goals %}
            {% assign health_goals_clean = product.metafields.custom.health_goals.value %}
            {% for goal in health_goals_clean.value %}
               {% assign trimmed_goal = goal | strip %}
              {% unless all_health_goals contains trimmed_goal %}
                {% assign all_health_goals = all_health_goals | append: trimmed_goal | append: ',' %}
              {% endunless %}
            {% endfor %}
          {% endif %}
        {% endfor %}

        {% assign unique_goals = all_health_goals | split: ',' | uniq %}
        {% for goal in unique_goals %}
          {% if goal != blank %}
            <div class="ai-product-carousel-filter-item-{{ ai_gen_id }}">
              <input
                type="checkbox"
                class="ai-product-carousel-filter-checkbox-{{ ai_gen_id }}"
                id="filter-{{ goal | handleize }}-{{ ai_gen_id }}"
                value="{{ goal }}"
              >
              <label
                for="filter-{{ goal | handleize }}-{{ ai_gen_id }}"
                class="ai-product-carousel-filter-label-{{ ai_gen_id }}"
              >
                {{ goal }}
              </label>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>

  <div class="ai-product-carousel-view-all-wrapper-{{ ai_gen_id }}">
    <a
      href="{{ block.settings.view_all_link }}"
      class="ai-product-carousel-view-all-{{ ai_gen_id }}"
    >
      {{ block.settings.view_all_text }}
    </a>
  </div>
</product-carousel-{{ ai_gen_id }}>

<script>
  (function() {
    class ProductCarousel{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.slider = this.querySelector('.ai-product-carousel-slider-{{ ai_gen_id }}');
        this.slides = this.querySelectorAll('.ai-product-carousel-slide-{{ ai_gen_id }}');
        this.checkboxes = this.querySelectorAll('.ai-product-carousel-filter-checkbox-{{ ai_gen_id }}');
        this.atcButtons = this.querySelectorAll('.ai-product-carousel-atc-{{ ai_gen_id }}');
        this.autoplayEnabled = this.dataset.autoplay === 'true';
        this.autoplaySpeed = parseInt(this.dataset.autoplaySpeed) || 3000;
        this.currentIndex = 0;
        this.autoplayInterval = null;
        this.allSlides = Array.from(this.slides);
      }

      connectedCallback() {
        this.setupFilters();
        this.setupAddToCart();
        if (this.autoplayEnabled) {
          this.startAutoplay();
        }
      }

      setupFilters() {
        this.checkboxes.forEach(checkbox => {
          checkbox.addEventListener('change', () => this.filterProducts());
        });
      }

      filterProducts() {
        const selectedGoals = Array.from(this.checkboxes)
          .filter(cb => cb.checked)
          .map(cb => cb.value.toLowerCase().trim());

        this.slides.forEach(slide => {
          let productGoals = slide.dataset.healthGoals || '[]';

          try {
            productGoals = JSON.parse(productGoals);
          } catch (e) {
            productGoals = [];
          }

          const normalizedGoals = productGoals.map(goal =>
            String(goal).toLowerCase().trim()
          );

          if (selectedGoals.length === 0) {
            slide.style.display = 'flex';
          } else {
            const hasMatch = selectedGoals.some(goal =>
              normalizedGoals.includes(goal)
            );

            slide.style.display = hasMatch ? 'flex' : 'none';
          }
        });

        this.currentIndex = 0;
        this.slider.style.transform = 'translateX(0px)'; // Reset physical visual position

        if (this.autoplayEnabled) {
          this.stopAutoplay();
          this.startAutoplay();
        }
      }

      setupAddToCart() {
        this.atcButtons.forEach(button => {
          button.addEventListener('click', (e) => {
            const variantId = e.target.dataset.variantId;
            this.addToCart(variantId);
          });
        });
      }

      addToCart(variantId) {
        fetch('/cart/add.js', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({
            id: variantId,
            quantity: 1
          })
        })
        .then(response => response.json())
        .then(data => {
          if (window.theme && window.theme.cart) {
            window.theme.cart.getCart();
          } else {
            window.location.href = '/cart';
          }
        })
        .catch(error => {
          console.error('Error adding to cart:', error);
        });
      }

      startAutoplay() {
        this.autoplayInterval = setInterval(() => {
          this.nextSlide();
        }, this.autoplaySpeed);
      }

      stopAutoplay() {
        if (this.autoplayInterval) {
          clearInterval(this.autoplayInterval);
        }
      }

      nextSlide() {
        const visibleSlides = Array.from(this.slides).filter(slide => slide.style.display !== 'none');
        if (visibleSlides.length === 0) return;

        this.currentIndex = (this.currentIndex + 1) % visibleSlides.length;

        // Get the width of one slide and the gap between them
        const slideWidth = visibleSlides[0].offsetWidth;
        const gap = parseFloat(window.getComputedStyle(this.slider).gap) || 0;
        
        // Calculate the total distance to shift the slider
        const moveDistance = (slideWidth + gap) * this.currentIndex;

        // Apply the CSS transform to move it
        this.slider.style.transform = `translateX(-${moveDistance}px)`;
      }

      disconnectedCallback() {
        this.stopAutoplay();
      }
    }

    customElements.define('product-carousel-{{ ai_gen_id }}', ProductCarousel{{ ai_gen_id }});
  })();
</script>

{% schema %}
