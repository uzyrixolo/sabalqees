}
.artianal-beekeeping-section .sub-heading {
    font-size: 16px;
    line-height: 1.35;
    letter-spacing: 0;
    color: #000;
    font-weight: 400;
    text-align: center;
    max-width: 560px;
    width: 100%;
    margin: 0 auto;
    padding-bottom: 44px;
}
.artianal-beekeeping-section .artisan-title{
    font-size: 16px;
    line-height: 1.25;
    letter-spacing: 0;
