    padding: 284px 40px 61px 40px;
}
.artianal-beekeeping-section .svg-img {
    max-width: 130px;
}
.artianal-beekeeping-section .artian-wrapper {
    gap: 50px;
}
.artianal-beekeeping-section .blog-title {
    font-size: 42px;
}
}
@media (min-width: 768px) and (max-width:991px) {
  .artianal-beekeeping-section .artisan-overlay {
    position: relative;
    padding: 284px 30px 61px 30px;
}
.artianal-beekeeping-section .svg-img {
    max-width: 115px;
}
.artianal-beekeeping-section .artian-wrapper {
    gap: 36px;
}
.artianal-beekeeping-section .blog-title {
    font-size: 34px;
    padding-bottom: 40px;
}
.artianal-beekeeping-section .artisan-title {
