    margin: 0 auto;
    padding: 0 16px;
}
.artianal-beekeeping-section .artisan-header h2 {
    margin: 0 0 16px;
    text-align: center;
}
.artianal-beekeeping-section .background-image{
    position:absolute;
    top:0;
    left:0;
    height:100%;
    width:100%;
}
.artianal-beekeeping-section .artisan-feature{
    width:33%;
}
.artianal-beekeeping-section .artisan-overlay {
    position: relative;
    padding: 354px 125px 81px 125px;
}
.artianal-beekeeping-section .artisan-image-wrap {
  position: relative;
}
 .artianal-beekeeping-section .artian-wrapper{
     display:flex;
    justify-content:space-Between;
    gap:87px;
}
.artianal-beekeeping-section .svg-img {
    max-width:141px;
    width:100%;
    margin:0 auto;
}
.artianal-beekeeping-section .svg-img img{
     width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
}
.artianal-beekeeping-section .blog-title {
    font-size: 48px;
    color: #fff;
