      <table class="t4s-table-res">
        <tbody>

          <!-- Available Points Row -->
          <tr>
            <td>
              <strong>Available Points</strong>
            </td>
            <td id="loyalty-points-value">{{ customer.metafields.custom.loyalty_points }}</td>
          </tr>
          <!-- Current Level Row -->
          <tr>
            <td>
              <strong>Current Level</strong>
            </td>
            <td>{{ customer.metafields.custom.loyalty_level }}</td>
          </tr>
          
