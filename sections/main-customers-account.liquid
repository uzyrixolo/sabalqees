<script>

    const container = document.getElementById('loyalty-root');
  const customerId = container?.dataset?.customerId;


  function getUnusedDiscountCodes(customerId){
    const requestOptions = {
  method: "GET",
  redirect: "follow"
};

fetch(`${BASE_URL}/redeem/unused_discount_codes?customer_id=${customerId}`, requestOptions)
  .then((response) => response.json())
  .then((result) => {
    const tableBody = document.getElementById('un-used-discont-codes-table');
        tableBody.innerHTML = ''; // Clear existing rows

        if (result.success && result.data.length > 0) {
          result.data.forEach(codeObj => {
            const date = new Date(codeObj.created_at).toLocaleDateString('en-US', {
              year: 'numeric', month: 'long', day: 'numeric'
            });

            const row = document.createElement('tr');
            const isApplied = codeObj?.is_applied;

const applyBtnHTML = `
  <td>
    <button
      onclick="applyDiscountCode('${codeObj?.code}', '${codeObj?.id}')"
      class="radeem-code-apply-btn"
      data-apply-discount-btn-id='${codeObj?.id}'
      ${isApplied ? 'disabled' : ''}
    >
      ${isApplied ? 'Already Applied' : 'Apply Now'}
    </button>
  </td>
`;
            row.innerHTML = `
              <td><strong>${date}</strong></td>
              <td>#${codeObj.code}</td>
              <td>${formatCurrency(codeObj.value, shopCurrency)}</td>
${applyBtnHTML}
            `;
            tableBody.appendChild(row);
          });
        } else {
          tableBody.innerHTML = `<tr><td colspan="4">No unused discount codes found.</td></tr>`;
        }
  })
  .catch((error) => console.error(error));

  }


    if (customerId) {
      fetch(`${BASE_URL}/redeem/${customerId}`,{
    method : "GET"
  }) // your external API
    .then(response => response.json())
    .then(data => {
      if (data?.success && Array.isArray(data?.data)) {
        const tbody = document.getElementById('redemption-history-rows');
        tbody.innerHTML = ''; // Clear existing rows

        if (data.data.length === 0) {
          tbody.innerHTML = `<tr><td colspan="4">No redemption history found.</td></tr>`;
          return;
        }

        data?.data.forEach(row => {
          const date = new Date(row.redeemed_at).toLocaleDateString('en-US', {
            year: 'numeric', month: 'long', day: 'numeric'
          });

          let status = 'Available';
          if (row.used) status = 'Used';
          else if (row.is_applied) status = 'Applied to Cart';

          const tr = document.createElement('tr');
          tr.innerHTML = `
            <td><strong>${date}</strong></td>
            <td>${row.points_used} pts</td>
            <td>${row.discount_code}</td>
            <td>${status}</td>
          `;
          tbody.appendChild(tr);
        });
      } else {
        console.warn("No redemption history found.");
      }
    })
    .catch(err => {
      
      console.error(err);
    });

    getUnusedDiscountCodes(customerId)

    }

    function redeemPoints() {
      const container = document.getElementById('loyalty-root');
  const customerId = container?.dataset?.customerId;

  const btn = document.getElementById('redeem-points-btn');

  // Show spinner + disable button
  btn.disabled = true;
  btn.innerHTML = `<i class="fa fa-spinner fa-spin"></i> Redeeming...`;

  fetch(`${BASE_URL}/redeem`, {
    method: "POST",
    headers: {
      "Content-Type": "application/json"
    },
    body: JSON.stringify({
      customer_id: customerId,
    })
  })
  .then(res => res.json())
  .then(data => {
    if (data?.success) {
      document.getElementById("redeem-message").innerHTML = '';
      
      const pointsEl = document.getElementById("loyalty-points-value");
      if (pointsEl) pointsEl.textContent = parseInt(pointsEl.textContent) - 50;

      resetButton();
      getUnusedDiscountCodes(customerId);

      // Show modern popup with copy functionality
      showDiscountPopup(data?.data?.code, data?.data?.id);
    } else {
      document.getElementById("redeem-message").textContent = data.message || "Redemption failed.";
            resetButton();

    }
  })
  .catch(err => {
    console.error(err);
    document.getElementById("redeem-message").textContent = "Something went wrong.";
        resetButton();

  });

   function resetButton() {
    const pointsEl = document.getElementById("loyalty-points-value");
    if (pointsEl) {
      if(parseInt(pointsEl.textContent) < 50 ){
        btn.disabled = true;
      } else{
        btn.disabled = false;
      }
    }

    // btn.disabled = false;
    btn.innerHTML = 'Redeem Points';
  }
}

  
</script>


<script>
  function applyDiscountCode(discountCode, discountId) {
  const storeDomain = 'sa.balqees.com';

    const btn = document.querySelector(`[data-apply-discount-btn-id="${discountId}"]`);

  if (btn) {
    // Show spinner and disable the button
    btn.disabled = true;
    btn.innerHTML = `<i class="fa fa-spinner fa-spin"></i> Applying...`;
  }

    fetch(`https://${storeDomain}/discount/${discountCode}`, {
      method: 'GET'
    })
    .then(res => {
      if (res.ok) {
        updateDiscountCodeStatus(parseInt(discountId));
        closeDiscountPopup();
        showDiscountPopup(discountCode, discountId, { applied: true });
      } else {
        showDiscountPopup(discountCode, discountId, {
          title: 'Could Not Apply',
          message: 'The discount code could not be applied. Please try again or use it manually at checkout.'
        });
        resetButton();
      }
    })
    .catch(error => {
      showDiscountPopup(discountCode, discountId, {
        title: 'Could Not Apply',
        message: 'Something went wrong. You can still copy the code and apply it manually at checkout.'
      });
      resetButton();
    });

    function resetButton() {
    if (btn) {
      btn.disabled = false;
      btn.innerHTML = "Apply Now";
    }
  }
}

</script>



