            <td colspan="2">
              <button class="radeem-points-btn"    id="redeem-points-btn"  {% if customer.metafields.custom.loyalty_points < 50 %} disabled="true"  {% endif %} onclick="redeemPoints()">Redeem Points</button>
              <div id="redeem-message" style="text-align: center; margin-top: 5px; margin-bottom: 5px;"></div>
            </td>
            
          </tr>
          {% if customer.metafields.custom.loyalty_points < 50 %}
          <tr>
            <td colspan="2">
