    {{ customer.default_address | format_address }}
    <div class="t4s-table-res-df">
      <table class="t4s-table-res">
        <tbody>
          <tr>
            <td>
              <strong>{{ 'customer.account.name' | t }}</strong>
            </td>
            <td>{{ customer_name }}</td>
          </tr>
          <tr>
            <td>
