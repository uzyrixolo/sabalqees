                  {{- customer.default_address.country }}
                </td>
              </tr>
            {%- endif -%}
            {%- if customer.default_address.zip != blank -%}
              <tr>
                <td>
                  <strong>{{ 'customer.account.zip' | t }}</strong>
                </td>
                <td>{{ customer.default_address.zip }}</td>
              </tr>
            {%- endif -%}
            {%- if customer.default_address.phone != blank -%}
              <tr>
                <td>
                  <strong>{{ 'customer.account.phone' | t }}</strong>
                </td>
                <td>{{ customer.default_address.phone }}</td>
              </tr>
            {%- endif -%}
          {%- endif -%}
        </tbody>
      </table>
    </div>

    
  </div>
</div>

<div id="loyalty-root"   data-customer-id="{{ customer.id }}"></div>

<!-- Discount Code Popup Modal -->
<div id="discount-popup-overlay" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.5); z-index:9999; justify-content:center; align-items:center;">
  <div style="background:#fff; border-radius:12px; padding:32px 28px; max-width:420px; width:90%; text-align:center; box-shadow:0 8px 32px rgba(0,0,0,0.2); position:relative;">
    <button onclick="closeDiscountPopup()" style="position:absolute; top:12px; right:16px; background:none; border:none; font-size:22px; cursor:pointer; color:#888;">&times;</button>
    <div style="font-size:40px; margin-bottom:12px;" id="popup-icon">🎉</div>
    <h3 style="margin:0 0 8px; font-size:20px; color:#333;" id="popup-title">Discount Code Generated!</h3>
    <p style="margin:0 0 16px; color:#666; font-size:14px;" id="popup-message">Your exclusive discount code is ready. Copy it and apply at checkout.</p>
    <div style="background:#f5f5f5; border:2px dashed #c9a96e; border-radius:8px; padding:14px 20px; margin-bottom:16px; display:flex; align-items:center; justify-content:center; gap:10px;">
      <span id="popup-code" style="font-size:20px; font-weight:700; letter-spacing:2px; color:#333;"></span>
      <button onclick="copyDiscountCode()" style="background:#c9a96e; color:#fff; border:none; border-radius:6px; padding:8px 14px; cursor:pointer; font-size:13px; font-weight:600; transition:background 0.2s;" onmouseover="this.style.background='#b8935d'" onmouseout="this.style.background='#c9a96e'">
        <i class="fa fa-copy"></i> Copy
      </button>
    </div>
    <p id="popup-copy-feedback" style="color:#4CAF50; font-size:13px; margin:0 0 16px; min-height:20px;"></p>
    <div id="popup-actions" style="display:flex; gap:10px; justify-content:center;">
      <button id="popup-apply-btn" onclick="" style="background:#c9a96e; color:#fff; border:none; border-radius:8px; padding:12px 24px; cursor:pointer; font-size:14px; font-weight:600; flex:1; transition:background 0.2s;" onmouseover="this.style.background='#b8935d'" onmouseout="this.style.background='#c9a96e'">Apply Now</button>
      <button onclick="closeDiscountPopup()" style="background:#f0f0f0; color:#555; border:none; border-radius:8px; padding:12px 24px; cursor:pointer; font-size:14px; font-weight:600; flex:1;">Later</button>
    </div>
    <p style="margin:12px 0 0; color:#999; font-size:12px;">This code is exclusive to your account and does not expire.</p>
  </div>
</div>

<script>
  function showDiscountPopup(code, discountId, options = {}) {
    const overlay = document.getElementById('discount-popup-overlay');
    const codeEl = document.getElementById('popup-code');
    const titleEl = document.getElementById('popup-title');
    const msgEl = document.getElementById('popup-message');
    const iconEl = document.getElementById('popup-icon');
    const applyBtn = document.getElementById('popup-apply-btn');
    const feedbackEl = document.getElementById('popup-copy-feedback');
    const actionsEl = document.getElementById('popup-actions');

    codeEl.textContent = code;
    feedbackEl.textContent = '';

    if (options.applied) {
      iconEl.textContent = '✅';
      titleEl.textContent = 'Discount Applied!';
      msgEl.textContent = 'Your discount has been applied to your cart. Happy shopping!';
      actionsEl.innerHTML = '<button onclick="closeDiscountPopup(); window.location.reload();" style="background:#c9a96e; color:#fff; border:none; border-radius:8px; padding:12px 24px; cursor:pointer; font-size:14px; font-weight:600; width:100%;">Continue Shopping</button>';
    } else {
      iconEl.textContent = '🎉';
      titleEl.textContent = options.title || 'Discount Code Generated!';
      msgEl.textContent = options.message || 'Your exclusive discount code is ready. Copy it and apply at checkout.';
      applyBtn.setAttribute('onclick', `applyDiscountCode('${code}', '${discountId}')`);
      actionsEl.innerHTML = `
        <button id="popup-apply-btn" onclick="applyDiscountCode('${code}', '${discountId}')" style="background:#c9a96e; color:#fff; border:none; border-radius:8px; padding:12px 24px; cursor:pointer; font-size:14px; font-weight:600; flex:1;">Apply Now</button>
        <button onclick="closeDiscountPopup()" style="background:#f0f0f0; color:#555; border:none; border-radius:8px; padding:12px 24px; cursor:pointer; font-size:14px; font-weight:600; flex:1;">Later</button>
      `;
    }

    overlay.style.display = 'flex';
  }

  function closeDiscountPopup() {
    document.getElementById('discount-popup-overlay').style.display = 'none';
  }

  function copyDiscountCode() {
    const code = document.getElementById('popup-code').textContent;
    navigator.clipboard.writeText(code).then(() => {
      document.getElementById('popup-copy-feedback').textContent = 'Copied to clipboard!';
      setTimeout(() => {
        document.getElementById('popup-copy-feedback').textContent = '';
      }, 2500);
    }).catch(() => {
      // Fallback for older browsers
      const textarea = document.createElement('textarea');
      textarea.value = code;
      document.body.appendChild(textarea);
      textarea.select();
      document.execCommand('copy');
      document.body.removeChild(textarea);
      document.getElementById('popup-copy-feedback').textContent = 'Copied to clipboard!';
    });
  }

  // Close popup on overlay click
  document.getElementById('discount-popup-overlay').addEventListener('click', function(e) {
    if (e.target === this) closeDiscountPopup();
  });
</script>

