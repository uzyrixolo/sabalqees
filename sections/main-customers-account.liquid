              >
            {%- endif -%}
          </li>
        {%- endif -%}
        <li class="t4s-account-nav-link t4s-account-nav-link--customer-logout">
          <a href="{{ routes.account_logout_url }}" data-no-instant>
            <svg
              viewBox="0 0 24 24"
              width="24"
