<style>
  .video-slider-section {
      background-color: {{section.settings.bg_color }};
  }

  .video-slider-section .card-box .img-block[data-video] {
      cursor: pointer;
  }

  .video-slider-section .page-width {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 16px;
  }

  .video-slider-section .card-box .img-block .review-video-trigger {
      position: absolute;
      bottom: 8px;
      left: 26px;
      transform: translate(-50%, -50%);
      display: flex;
      z-index: 2;
  }

  .video-slider-section .card-box {
      position: relative;
  }

  .video-slider-section .image-part-blog .tools-image {
      text-decoration: none;
      display: block;
  }

 

  .video-slider-section:not(.swiper-initialized) .swiper-slide {
      width: calc(20% - 15px);
      margin-right: 20px;
  }

  .video-slider-section .img-block img {
      height: 100%;
      width: 100%;
      border-radius: 6px;
      aspect-ratio: 0.46/1;
      display: block;
  }

  .video-slider-section .heading-wrap {
      margin: 0 0 36px 0;
      text-align: center;
  }

  .video-slider-section .upper-blog {
      position: absolute;
      top: 14px;
      right: 12px;
      z-index: 1;
  }

  .video-slider-section .swiper-slide {
      height: auto;
      display: flex;
    flex-direction: column;
  }

  .video-slider-section .testimonial-main-box {
      padding: 67px 0 64px 0;
  }

  .video-slider-section .text {
      font-size: 14px;
      font-weight: 400;
      letter-spacing: 0;
      text-align: center;
      line-height: 1.4;
      color: #000;
      margin: 0;
  }

  .video-slider-section .content-wrapper {
      display: flex;
      align-items: center;
      width: 100%;
      height:100%;
      flex-direction: column;
      border-radius: 5px;
      justify-content: flex-start;
      background: linear-gradient(180deg, #FFFFFF 0%, rgba(255, 255, 255, 0.25) 100%);
      padding: 19px 17px 30px 17px;
  }

  .video-slider-section .author {
      font-size: 16px;
      font-weight: 700;
      letter-spacing: 0;
      text-align: center;
      line-height: 1.25;
      color: #000;
      margin: 0 0 5px 0;
  }
  .video-slider-section .review-video{
      width:100%;
      height:100%;
      object-fit:cover;
      border-radius:6px;
      display:block;
    }
    .video-slider-section .swiper-slide {
    height: auto;
}

  @media (min-width: 768px) and (max-width:1200px) {
      .video-slider-section .page-width {
          padding: 0;
      }

      .video-slider-section .swiper {
          padding-inline: 12px;
      }

      .video-slider-section .testimonial-main-box {
          padding: 40px 0;
      }

      .video-slider-section .heading-wrap {
          margin: 0 0 20px 0;
      }
  }

  @media(max-width:767px) {
      .video-slider-section:not(.swiper-initialized) .swiper-slide {
          width: calc(100% - 15px);
          margin-right: 20px;
      }

      .video-slider-section .testimonial-main-box {
          padding: 45px 0 45px 0;
      }

      .video-slider-section .author {
          font-size: 14px;
      }

      .video-slider-section .text {
          font-size: 12px;
      }

      .video-slider-section .page-width {
          padding: 0;
      }

      .video-slider-section .swiper {
          padding-inline: 12px;
      }

      .video-slider-section .heading-wrap {
          margin: 0 0 25px 0;
          padding-inline: 12px;
      }

      .video-slider-section .img-block img {
          border-radius: 5px;
          aspect-ratio: 0.49/1;
      }

      .video-slider-section .svg-blog img {
          height: 19px;
          width: 18px;
          display: block;
      }

      .video-slider-section .review-video-trigger svg {
          height: 22px;
          width: 22px;
          display: block;
      }

      .video-slider-section .content-wrapper {
          padding: 18px 15px 25px 15px;
      }
  }
</style>
<section class="video-slider-section">
  <div class="page-width">
    <div class="testimonial-main-box">
      <div class="heading-wrapper">
        {% if section.settings.heading != blank %}
          <h2 class="heading-wrap">{{ section.settings.heading }}</h2>
        {% endif %}
      </div>
      <div class="testimonial-wrapper">
        <div class="swiper swiper-slider video-blog-slider">
          <div class="swiper-wrapper">
            {% for block in section.blocks %}
              <div class="swiper-slide" data-block-id="{{ block.id }}">
                <div class="card-box">
                  {% liquid
                    assign videoObj = block.settings.video.sources | where: 'format', 'mp4'
                    assign videoURL = videoObj[0].url
                  %}

                  <div class="img-block">
                    {% if block.settings.video != blank %}
                      <!-- Video Element with Poster -->
                      <video class="review-video" playsinline{% if block.settings.fallback_image != blank %} poster="{{ block.settings.fallback_image | image_url }}"{% endif %}>
                        <source src="{{ videoURL }}" type="video/mp4">
                      </video>

                      <a href="#" class="review-video-trigger">
                        <svg xmlns="http://www.w3.org/2000/svg" width="29" height="29" viewBox="0 0 29 29" fill="none">
                          <path d="M26.6871 14.2332C26.6879 14.5352 26.6104 14.8323 26.4623 15.0955C26.3142 15.3588 26.1005 15.5792 25.842 15.7354L9.82055 25.5365C9.55044 25.7019 9.24106 25.7922 8.92438 25.798C8.6077 25.8039 8.2952 25.7251 8.01914 25.5698C7.74572 25.4169 7.51794 25.194 7.35925 24.9239C7.20056 24.6538 7.11667 24.3463 7.11621 24.0331V4.43324C7.11667 4.11998 7.20056 3.81249 7.35925 3.5424C7.51794 3.27231 7.74572 3.04936 8.01914 2.89648C8.2952 2.74119 8.6077 2.66241 8.92438 2.66827C9.24106 2.67414 9.55044 2.76444 9.82055 2.92984L25.842 12.7309C26.1005 12.8871 26.3142 13.1075 26.4623 13.3708C26.6104 13.634 26.6879 13.9311 26.6871 14.2332Z" fill="white"/>
                        </svg>
                      </a>
                    {% endif %}
                  </div>
                </div>
                <div class="content-wrapper">
                  <div class="rateing-blog">
                    {% if block.settings.star_img != blank %}
                      <div class="svg-star-image">
                        <img
                          src="{{ block.settings.star_img | image_url }}"
                          alt="{{ block.settings.heading }}"
                          width="{{ block.settings.star_img.width }}"
                          height="{{ block.settings.star_img.height }}"
                          loading="lazy"
                        >
                      </div>
                    {% endif %}
                  </div>
                  {% if block.settings.author_name != blank %}
                    <div class="author body-font">{{ block.settings.author_name }}</div>
                  {% endif %}

                  {% if block.settings.text_wrapper != blank %}
                    <div class="text body-font">{{ block.settings.text_wrapper }}</div>
                  {% endif %}
                </div>
              </div>
            {% endfor %}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
<script>
document.addEventListener('DOMContentLoaded', (event) => {

  var slider = new Swiper('.video-blog-slider', {
    slidesPerView: 2.15,
    spaceBetween: 10,
    centeredSlides: true,
    loop: true,
    breakpoints: {
      560: {
        slidesPerView: 2.4,
        spaceBetween: 10,
        centeredSlides: true,
      },
      767: {
        slidesPerView: 3.3,
        spaceBetween: 10,
        centeredSlides: true,
      },
      1024: {
        slidesPerView: 3.7,
        spaceBetween: 10,
        centeredSlides: true,
      },
      1200: {
        slidesPerView: 5,
        spaceBetween: 13,
        centeredSlides: false,
      },
    },
  });

  slider.update();

  // VIDEO PLAY SCRIPT
  document.querySelectorAll('.review-video-trigger').forEach((btn) => {
    btn.addEventListener('click', function(e) {
      e.preventDefault();

      const block = this.closest('.img-block');
      const video = block.querySelector('video');

      if (video.paused) {
        video.play();
      } else {
        video.pause();
      }
    });
  });

});
</script>
{% schema %}
{
  "name": "Video Slider Section",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Select Background Color"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Add Heading"
    }
  ],
  "blocks": [
    {
      "type": "review_block",
      "name": "Review Slide",
      "settings": [
        {
          "type": "video",
          "id": "video",
          "label": "Select Video"
        },
        {
          "type": "image_picker",
          "id": "fallback_image",
          "label": "Video Thumbnail/Fallback Image"
        },
        {
          "type": "image_picker",
          "id": "instragram_img",
          "label": "Add Svg Image"
        },
        {
          "type": "image_picker",
          "id": "star_img",
          "label": "Add Svg Image"
        },
        {
          "type": "inline_richtext",
          "id": "author_name",
          "label": "Add Name"
        },
        {
          "type": "inline_richtext",
          "id": "text_wrapper",
          "label": "Add Text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Video Slider Section"
    }
  ]
}
{% endschema %}
