{% assign ai_gen_id = block.id | default: section.id | replace: '_', '' | downcase %}
{% assign js_safe_id = ai_gen_id | replace: '-', '' | replace: '_', '' %}

{% style %}
  /* 1. Force strict sizing on ALL elements inside this section */
  .ai-product-carousel-{{ ai_gen_id }},
  .ai-product-carousel-{{ ai_gen_id }} * {
    box-sizing: border-box !important;
  }

  /* 2. Lock the main container to prevent horizontal scrolling and center it */
  .ai-product-carousel-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    max-width: 90vw;
    margin: 0 auto;
    overflow: hidden;
    padding-top: {{ section.settings.padding_top_desktop }}px;
    padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
    padding-left: {{ section.settings.padding_horizontal_desktop }}px;
    padding-right: {{ section.settings.padding_horizontal_desktop }}px;
    background-color: {{ section.settings.background_color }};
  }

  .ai-product-carousel-inner-{{ ai_gen_id }} {
    width: {{ section.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    overflow: hidden;
  }

  .ai-product-carousel-header-{{ ai_gen_id }} {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    flex-wrap: wrap;
    gap: 20px;
    margin-bottom: {{ section.settings.heading_spacing }}px;
  }

  .ai-product-carousel-heading-group-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    flex: 1; /* Allows group to span 100% width when no button exists */
    min-width: 0;
    gap: {{ section.settings.subheading_spacing }}px;
  }

  .ai-product-carousel-heading-{{ ai_gen_id }} {
    font-size: {{ section.settings.heading_font_size }}px;
    color: {{ section.settings.heading_color }};
    margin: 0;
    font-weight: {{ section.settings.heading_font_weight }};
    text-align: {{ section.settings.heading_alignment }};
    width: 100%;
    word-break: break-word;
    overflow-wrap: break-word;
  }

  .ai-product-carousel-subheading-{{ ai_gen_id }} {
    font-size: {{ section.settings.subheading_font_size }}px;
    color: {{ section.settings.subheading_color }};
    margin: 0;
    font-weight: {{ section.settings.subheading_font_weight }};
    text-align: {{ section.settings.heading_alignment }};
    width: 100%;
    word-break: break-word;
    overflow-wrap: break-word;
  }

  /* Shared Button Styles */
  .ai-product-carousel-btn-{{ ai_gen_id }} {
    display: inline-block;
    padding: {{ section.settings.btn_padding_v }}px {{ section.settings.btn_padding_h }}px;
    background-color: {{ section.settings.btn_bg_color }};
    color: {{ section.settings.btn_text_color }};
    text-decoration: none;
    font-size: {{ section.settings.btn_font_size }}px;
    font-weight: {{ section.settings.btn_font_weight }};
    border-radius: {{ section.settings.btn_border_radius }}px;
    border: {{ section.settings.btn_border_width }}px solid {{ section.settings.btn_border_color }};
    transition: opacity 0.3s ease;
  }

  .ai-product-carousel-btn-{{ ai_gen_id }}:hover {
    opacity: 0.8;
    color: {{ section.settings.btn_text_color }};
  }

  /* Bottom Button Specific */
  .ai-product-carousel-bottom-action-{{ ai_gen_id }} {
    margin-top: {{ section.settings.bottom_btn_spacing_top }}px;
    text-align: {{ section.settings.bottom_btn_alignment }};
  }

  .ai-product-carousel-btn-bottom-{{ ai_gen_id }} {
    display: inline-block;
    padding: {{ section.settings.bottom_btn_padding_v }}px {{ section.settings.bottom_btn_padding_h }}px;
    background-color: {{ section.settings.bottom_btn_bg_color }};
    color: {{ section.settings.bottom_btn_text_color }};
    text-decoration: none;
    font-size: {{ section.settings.bottom_btn_font_size }}px;
    font-weight: {{ section.settings.bottom_btn_font_weight }};
    border-radius: {{ section.settings.bottom_btn_border_radius }}px;
    border: {{ section.settings.bottom_btn_border_width }}px solid {{ section.settings.bottom_btn_border_color }};
    transition: opacity 0.3s ease;
  }

  .ai-product-carousel-btn-bottom-{{ ai_gen_id }}:hover {
    opacity: 0.8;
    color: {{ section.settings.bottom_btn_text_color }};
  }

  /* Layout with external arrows */
  .ai-product-carousel-main-wrap-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: {{ section.settings.arrow_gap_desktop }}px;
  }

  .ai-product-carousel-arrow-{{ ai_gen_id }} {
    flex-shrink: 0;
    cursor: pointer;
    width: {{ section.settings.arrow_size }}px;
    height: {{ section.settings.arrow_size }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: {{ section.settings.arrow_bg_color }};
    border: {{ section.settings.arrow_border_width }}px solid {{ section.settings.arrow_border_color }};
    border-radius: {{ section.settings.arrow_border_radius }}px;
    padding: {{ section.settings.arrow_padding }}px;
    transition: all 0.3s ease;
  }

  .ai-product-carousel-arrow-{{ ai_gen_id }}:hover {
    opacity: 0.7;
  }

  .ai-product-carousel-arrow-{{ ai_gen_id }} img, 
  .ai-product-carousel-arrow-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    object-fit: contain;
    fill: {{ section.settings.arrow_icon_color }};
    color: {{ section.settings.arrow_icon_color }};
  }

  .ai-product-carousel-container-{{ ai_gen_id }} {
    flex-grow: 1;
    position: relative;
    overflow: hidden;
    min-width: 0;
  }

  .ai-product-carousel-wrapper-{{ ai_gen_id }} {
    display: flex;
    gap: {{ section.settings.slide_gap_desktop }}px;
    /* Transition is now handled by JS for the infinite loop */
  }

  .ai-product-carousel-slide-{{ ai_gen_id }} {
    flex: 0 0 calc({{ section.settings.slide_width }}% - ({{ section.settings.slide_gap_desktop }}px * (100 - {{ section.settings.slide_width }}) / 100));
    padding: 0;
    box-sizing: border-box;
  }

  .ai-product-carousel-card-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    text-decoration: none;
    color: inherit;
  }

  .ai-product-carousel-image-wrapper-{{ ai_gen_id }} {
    width: 100%;
    position: relative;
    overflow: hidden;
    border-radius: {{ section.settings.image_border_radius }}px;
    margin-bottom: {{ section.settings.spacing_below_image }}px;
  }

  .ai-product-carousel-image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    display: block;
    aspect-ratio: {{ section.settings.image_aspect_ratio }};
    object-fit: cover;
    transition: opacity 0.4s ease;
  }

  .ai-product-carousel-image-secondary-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    opacity: 0;
    z-index: 2;
  }

  @media (hover: hover) {
    .ai-product-carousel-card-{{ ai_gen_id }}:hover .ai-product-carousel-image-secondary-{{ ai_gen_id }} {
      opacity: 1;
    }
    .ai-product-carousel-card-{{ ai_gen_id }}:hover .ai-product-carousel-image-primary-has-secondary-{{ ai_gen_id }} {
      opacity: 0;
    }
  }

  .ai-product-carousel-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: {{ section.settings.image_aspect_ratio }};
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-product-carousel-image-placeholder-{{ ai_gen_id }} svg {
    width: 50%;
    height: 50%;
    opacity: 0.3;
  }

  .ai-product-carousel-title-{{ ai_gen_id }} {
    font-family: {{ settings.type_accent_font.family }}, {{ settings.type_accent_font.fallback_families }};
    font-weight: {{ settings.type_accent_font.weight }};
    font-style: {{ settings.type_accent_font.style }};
    font-size: {{ section.settings.title_font_size }}px;
    color: {{ section.settings.title_color }};
    margin: 0 0 {{ section.settings.spacing_below_title }}px;
  }

  .ai-product-carousel-price-{{ ai_gen_id }} {
    font-family: {{ settings.type_accent_font.family }}, {{ settings.type_accent_font.fallback_families }};
    font-weight: {{ settings.type_accent_font.weight }};
    font-style: {{ settings.type_accent_font.style }};
    font-size: {{ section.settings.price_font_size }}px;
    color: {{ section.settings.price_color }};
    margin: 0;
  }

  .ai-product-carousel-price-compare-{{ ai_gen_id }} {
    text-decoration: line-through;
    opacity: 0.6;
    margin-right: 8px;
  }

  .ai-product-carousel-pagination-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    gap: {{ section.settings.pagination_gap }}px;
    margin-top: {{ section.settings.pagination_spacing }}px;
  }

  .ai-product-carousel-dot-{{ ai_gen_id }} {
    width: {{ section.settings.pagination_size }}px;
    height: {{ section.settings.pagination_size }}px;
    border-radius: 50%;
    background-color: {{ section.settings.pagination_inactive_color }};
    border: none;
    padding: 0;
    cursor: pointer;
    transition: background-color 0.3s ease;
  }

  .ai-product-carousel-dot-{{ ai_gen_id }}.active {
    background-color: {{ section.settings.pagination_active_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-product-carousel-{{ ai_gen_id }} {
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
      padding-left: {{ section.settings.padding_horizontal_mobile }}px;
      padding-right: {{ section.settings.padding_horizontal_mobile }}px;
    }
    
    .ai-product-carousel-wrapper-{{ ai_gen_id }} {
      gap: {{ section.settings.slide_gap_mobile }}px;
    }

    .ai-product-carousel-slide-{{ ai_gen_id }} {
      flex: 0 0 calc({{ section.settings.mobile_slide_width }}% - ({{ section.settings.slide_gap_mobile }}px * (100 - {{ section.settings.mobile_slide_width }}) / 100));
    }

    .ai-product-carousel-header-{{ ai_gen_id }} {
      flex-direction: column;
      align-items: stretch;
      gap: 15px;
    }

      .ai-product-carousel-heading-{{ ai_gen_id }} {
        font-size: 36px;
      }

    .ai-product-carousel-btn-{{ ai_gen_id }} {
      align-self: {% if section.settings.heading_alignment == 'center' %}center{% elsif section.settings.heading_alignment == 'right' %}flex-end{% else %}flex-start{% endif %};
    }

    .ai-product-carousel-main-wrap-{{ ai_gen_id }} {
      gap: {{ section.settings.arrow_gap_mobile }}px;
    }

    {% if section.settings.hide_arrows_mobile %}
      .ai-product-carousel-arrow-{{ ai_gen_id }} {
        display: none !important;
      }
    {% endif %}
  }
{% endstyle %}

<product-carousel-{{ ai_gen_id }}
  class="ai-product-carousel-{{ ai_gen_id }}"
  data-autoplay="{{ section.settings.autoplay }}"
  data-autoplay-speed="{{ section.settings.autoplay_speed }}"
>
  <div class="ai-product-carousel-inner-{{ ai_gen_id }}">
    
  {% if section.settings.heading != blank or section.settings.subheading != blank or section.settings.button_label != blank %}
    <div class="ai-product-carousel-header-{{ ai_gen_id }}">
      
      <div class="ai-product-carousel-heading-group-{{ ai_gen_id }}">
        {% if section.settings.heading != blank %}
          <h2 class="ai-product-carousel-heading-{{ ai_gen_id }}">{{ section.settings.heading }}</h2>
        {% endif %}
        {% if section.settings.subheading != blank %}
          <p class="ai-product-carousel-subheading-{{ ai_gen_id }}">{{ section.settings.subheading }}</p>
        {% endif %}
      </div>
      
      {% if section.settings.button_label != blank %}
        <a href="{{ section.settings.button_link }}" class="ai-product-carousel-btn-{{ ai_gen_id }}">
          {{ section.settings.button_label }}
        </a>
      {% endif %}

    </div>
  {% endif %}
  
    <div class="ai-product-carousel-main-wrap-{{ ai_gen_id }}">
      
      {% if section.settings.show_arrows %}
        <div class="ai-product-carousel-arrow-{{ ai_gen_id }} ai-product-carousel-arrow-prev-{{ ai_gen_id }}">
          {% if section.settings.arrow_left_image != blank %}
            <img src="{{ section.settings.arrow_left_image | image_url: width: 100 }}" alt="Previous" loading="lazy">
          {% else %}
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
          {% endif %}
        </div>
      {% endif %}

      <div class="ai-product-carousel-container-{{ ai_gen_id }}">
        <div class="ai-product-carousel-wrapper-{{ ai_gen_id }}">
          {% if section.settings.collection != blank and section.settings.collection.products.size > 0 %}
            
            {% for product in section.settings.collection.products limit: section.settings.products_limit %}
              <div class="ai-product-carousel-slide-{{ ai_gen_id }}">
                <a href="{{ product.url }}" class="ai-product-carousel-card-{{ ai_gen_id }}">
                  <div class="ai-product-carousel-image-wrapper-{{ ai_gen_id }}">
                    {% if product.featured_image %}
                      <img
                        src="{{ product.featured_image | image_url: width: 800 }}"
                        alt="{{ product.featured_image.alt | escape }}"
                        class="ai-product-carousel-image-{{ ai_gen_id }} {% if product.images[1] %}ai-product-carousel-image-primary-has-secondary-{{ ai_gen_id }}{% endif %}"
                        loading="lazy"
                        width="800"
                        height="800"
                      >
                      {% if product.images[1] %}
                        <img
                          src="{{ product.images[1] | image_url: width: 800 }}"
                          alt="{{ product.images[1].alt | escape }}"
                          class="ai-product-carousel-image-{{ ai_gen_id }} ai-product-carousel-image-secondary-{{ ai_gen_id }}"
                          loading="lazy"
                          width="800"
                          height="800"
                        >
                      {% endif %}
                    {% else %}
                      <div class="ai-product-carousel-image-placeholder-{{ ai_gen_id }}">
                        {{ 'product-1' | placeholder_svg_tag }}
                      </div>
                    {% endif %}
                  </div>
                  <h3 class="ai-product-carousel-title-{{ ai_gen_id }}">{{ product.title }}</h3>
                  <div class="ai-product-carousel-price-{{ ai_gen_id }}">
                    {% if product.compare_at_price > product.price %}
                      <span class="ai-product-carousel-price-compare-{{ ai_gen_id }}">{{ product.compare_at_price | money }}</span>
                    {% endif %}
                    <span>{{ product.price | money }}</span>
                  </div>
                </a>
              </div>
            {% endfor %}

          {% else %}
            {% for i in (1..6) %}
              <div class="ai-product-carousel-slide-{{ ai_gen_id }}">
                <div class="ai-product-carousel-card-{{ ai_gen_id }}">
                  <div class="ai-product-carousel-image-wrapper-{{ ai_gen_id }}">
                    <div class="ai-product-carousel-image-placeholder-{{ ai_gen_id }}">
                      {{ 'product-1' | placeholder_svg_tag }}
                    </div>
                  </div>
                  <h3 class="ai-product-carousel-title-{{ ai_gen_id }}">Product {{ i }}</h3>
                  <div class="ai-product-carousel-price-{{ ai_gen_id }}">AED 0.00</div>
                </div>
              </div>
            {% endfor %}
          {% endif %}
        </div>
      </div>

      {% if section.settings.show_arrows %}
        <div class="ai-product-carousel-arrow-{{ ai_gen_id }} ai-product-carousel-arrow-next-{{ ai_gen_id }}">
          {% if section.settings.arrow_right_image != blank %}
            <img src="{{ section.settings.arrow_right_image | image_url: width: 100 }}" alt="Next" loading="lazy">
          {% else %}
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
          {% endif %}
        </div>
      {% endif %}

    </div>

    {% if section.settings.show_pagination %}
      <div class="ai-product-carousel-pagination-{{ ai_gen_id }}"></div>
    {% endif %}

    {% if section.settings.show_bottom_button and section.settings.bottom_button_label != blank %}
      <div class="ai-product-carousel-bottom-action-{{ ai_gen_id }}">
        <a href="{{ section.settings.bottom_button_link }}" class="ai-product-carousel-btn-bottom-{{ ai_gen_id }}">
          {{ section.settings.bottom_button_label }}
        </a>
      </div>
    {% endif %}

  </div>
</product-carousel-{{ ai_gen_id }}>

<script>
  (function() {
    class ProductCarousel{{ js_safe_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentIndex = 0;
        this.autoplayInterval = null;
        this.isAnimating = false;
      }

      connectedCallback() {
        setTimeout(() => {
          this.initCarousel();
        }, 50);
      }

      initCarousel() {
        this.wrapper = this.querySelector('.ai-product-carousel-wrapper-{{ ai_gen_id }}');
        this.originalSlides = Array.from(this.querySelectorAll('.ai-product-carousel-slide-{{ ai_gen_id }}'));
        this.pagination = this.querySelector('.ai-product-carousel-pagination-{{ ai_gen_id }}');
        
        this.prevBtn = this.querySelector('.ai-product-carousel-arrow-prev-{{ ai_gen_id }}');
        this.nextBtn = this.querySelector('.ai-product-carousel-arrow-next-{{ ai_gen_id }}');

        this.autoplay = this.dataset.autoplay === 'true';
        this.autoplaySpeed = parseInt(this.dataset.autoplaySpeed) || 3000;
        
        if (!this.originalSlides || this.originalSlides.length === 0) return;
        this.totalOriginal = this.originalSlides.length;

        // Clone slides for seamless infinite loop
        const clonesBefore = this.originalSlides.map(s => s.cloneNode(true));
        const clonesAfter = this.originalSlides.map(s => s.cloneNode(true));
        
        clonesBefore.forEach(clone => {
            clone.classList.add('clone-slide');
            this.wrapper.insertBefore(clone, this.originalSlides[0]);
        });
        clonesAfter.forEach(clone => {
            clone.classList.add('clone-slide');
            this.wrapper.appendChild(clone);
        });

        // Set starting index to the first real slide
        this.currentIndex = this.totalOriginal;
        
        this.setupPagination();
        
        // Initial setup without animation
        this.updateCarousel(false);
        
        if (this.autoplay) {
          this.startAutoplay();
        }
        
        this.addEventListener('mouseenter', () => this.stopAutoplay());
        this.addEventListener('mouseleave', () => {
          if (this.autoplay) {
            this.startAutoplay();
          }
        });

        if (this.prevBtn) {
          this.prevBtn.addEventListener('click', (e) => {
            e.preventDefault();
            this.stopAutoplay();
            this.prevSlide();
          });
        }

        if (this.nextBtn) {
          this.nextBtn.addEventListener('click', (e) => {
            e.preventDefault();
            this.stopAutoplay();
            this.nextSlide();
          });
        }
        
        window.addEventListener('resize', () => {
           this.updateCarousel(false);
        });
      }

      setupPagination() {
        if (!this.pagination) return;
        
        this.pagination.innerHTML = '';
        for (let i = 0; i < this.totalOriginal; i++) {
          const dot = document.createElement('button');
          dot.classList.add('ai-product-carousel-dot-{{ ai_gen_id }}');
          dot.setAttribute('aria-label', 'Go to slide ' + (i + 1));
          dot.addEventListener('click', () => {
            if (this.isAnimating) return;
            this.stopAutoplay();
            this.goToSlide(i);
          });
          this.pagination.appendChild(dot);
        }
      }

      updateCarousel(animate = true) {
        if (!this.wrapper || !this.wrapper.children.length) return;
        
        const slideWidth = this.wrapper.children[0].getBoundingClientRect().width;
        const gap = parseFloat(window.getComputedStyle(this.wrapper).gap) || 0;
        const offset = -this.currentIndex * (slideWidth + gap);
        
        this.wrapper.style.transition = animate ? 'transform 0.5s ease' : 'none';
        this.wrapper.style.transform = `translateX(${offset}px)`;
        
        if (this.pagination) {
          const dots = this.pagination.querySelectorAll('.ai-product-carousel-dot-{{ ai_gen_id }}');
          // Map the current infinite index back to the dot index
          const activeIndex = this.currentIndex % this.totalOriginal;
          dots.forEach((dot, index) => {
            if (index === activeIndex) {
              dot.classList.add('active');
            } else {
              dot.classList.remove('active');
            }
          });
        }
      }

      goToSlide(index) {
        // Map dot index back to the active middle section
        this.currentIndex = index + this.totalOriginal;
        this.updateCarousel(true);
      }

      nextSlide() {
        if (this.isAnimating) return;
        this.isAnimating = true;
        
        this.currentIndex++;
        this.updateCarousel(true);
        
        // Wait for CSS transition to finish (500ms) before snapping back silently
        setTimeout(() => {
          if (this.currentIndex >= this.totalOriginal * 2) {
            this.currentIndex -= this.totalOriginal;
            this.updateCarousel(false);
          }
          this.isAnimating = false;
        }, 500);
      }

      prevSlide() {
        if (this.isAnimating) return;
        this.isAnimating = true;
        
        this.currentIndex--;
        this.updateCarousel(true);
        
        // Wait for CSS transition to finish (500ms) before snapping back silently
        setTimeout(() => {
          if (this.currentIndex < this.totalOriginal) {
            this.currentIndex += this.totalOriginal;
            this.updateCarousel(false);
          }
          this.isAnimating = false;
        }, 500);
      }

      startAutoplay() {
        this.stopAutoplay();
        this.autoplayInterval = setInterval(() => {
          this.nextSlide();
        }, this.autoplaySpeed);
      }

      stopAutoplay() {
        if (this.autoplayInterval) {
          clearInterval(this.autoplayInterval);
          this.autoplayInterval = null;
        }
      }

      disconnectedCallback() {
        this.stopAutoplay();
      }
    }

    if (!customElements.get('product-carousel-{{ ai_gen_id }}')) {
      customElements.define('product-carousel-{{ ai_gen_id }}', ProductCarousel{{ js_safe_id }});
    }
  })();
</script>

{% schema %}
{
  "name": "Products carousel",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Featured products"
    },
    {
      "type": "range",
      "id": "heading_font_size",
      "label": "Heading font size",
      "min": 16,
      "max": 72,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "select",
      "id": "heading_font_weight",
      "label": "Heading font weight",
      "options": [
        { "value": "400", "label": "Normal" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semibold" },
        { "value": "700", "label": "Bold" }
      ],
      "default": "700"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#000000"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "heading_spacing",
      "label": "Spacing below header block",
      "min": 10,
      "max": 80,
      "step": 5,
      "unit": "px",
      "default": 40
