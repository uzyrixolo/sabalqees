      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "inline_richtext",
      "id": "sub_text",
      "label": "Add Sub Text"
    },
    {
      "type": "text",
      "id": "btn_txt",
      "label": "Button Text"
    },
    {
      "type": "url",
      "id": "btn_url",
      "label": "Button Link"
    },
    {
      "type": "color",
      "id": "btn_bg_color",
      "label": "Button background color"
    },
    {
      "type": "color",
      "id": "btn_text_color",
      "label": "Button text color"
    }
  ],
  "blocks": [
    {
      "type": "tab-block",
      "name": "Tab Block",
      "settings": [
        {
          "type": "inline_richtext",
          "id": "heading",
          "label": "Add Name"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Add Answer"
        },
        {
          "type": "image_picker",
          "id": "slide_image",
          "label": "Select Slide Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Image Tab section"
    }
  ]
}
{% endschema %}
