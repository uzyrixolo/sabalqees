<style>
    .our-process-section {
        padding: 74px 0 105px 0;
        position: relative;
        background-color: {{section.settings.bg_color }};
        text-align: center;
    }
    .our-process-section .section-title {
        line-height: 1.12;
        font-size:32px;
    }
    .our-process-section::after {
        content: "";
        position: absolute;
        border-bottom: 1px dashed #000;
        width: 100%;
        top: 60%;
        left: 0;
        z-index: 1;
    }
    .our-process-section .process-content {
        position: relative;
        z-index: 2;
    }
    .our-process-section .page-width {
        max-width: 1260px;
        margin: 0 auto;
        padding: 0 16px;
        position:relative;
    }
    .our-process-section .section-subtitle {
        font-size: 16px;
        color: #000;
        letter-spacing: 0;
        line-height: 1.2;
        font-weight: 400;
        margin: 0 0 68px 0;
    }
    .our-process-section .content-wrap {
        display: none;
    }
    .our-process-section .process-item.active .content-wrap {
        display: block;
    }
    .our-process-section .process-item:hover .content-wrap {
        display: block;
    }
    .our-process-section .process-wrapper {
        display: flex;
        justify-content: center;
        gap: 136px;
        position: relative;
        z-index: 2;
    }
    .our-process-section .hex-title {
        font-size: 16px;
        font-weight: 700;
        letter-spacing: 0;
        line-height: 1.25;
        color: #fff;
        margin: 0 0 5px 0;
    }
    .our-process-section .content-wrap {
        font-size: 16px;
        font-weight: 400;
        letter-spacing: 0;
        line-height: 1.25;
        color: #fff;
        display: none;
        margin: 0;
    }
    .our-process-section .title-blog {
        padding-bottom: 20px;
    }
    .our-process-section .content-wrap p {
        margin: 0;
    }
    .our-process-section .process-item {
        cursor: pointer;
        width: 33.33%;
    }
    .our-process-section .hexagon {
        position: relative;
        overflow: hidden;
        transition: transform 0.4s ease;
        max-width: 261px;
        margin: 0 auto;
    }
    .our-process-section .process-content {
        position: absolute;
        top: 50%;
        left: 50%;
        width: 100%;
        transform: translate(-50%, -50%);
        max-width: 290px;
    }
    .our-process-section .hexagon img {
        width: 100%;
        height: 100%;
        border-radius: 25px;
        object-fit: cover;
    }
    .our-process-section .process-item.active .hexagon {
        transform: scale(1.50);
    }
    .our-process-section .hex-title,
    .our-process-section .content-wrap {
        font-size: 16px;
    }
    .our-process-section .process-item.active .process-content {
        transform: translate(-50%, -50%) scale(0.67);
    }

    .lab-test-download {
        display: inline-flex;
        align-items: center;
        justify-content: space-between;
        font-weight: 700;
        text-transform: uppercase;
        border-block: 1px solid #000;
        padding: 10px 0;
        color: #000;
        text-decoration: none;
        margin-top: 80px;
        font-size: 16px;
        line-height: 1.3;
        gap: 30px;
        font-family: 'Aeonik';
    }
    .lab-test-download:hover {
        color: #000;
    }

    @media (max-width:1300px) {
        .our-process-section .process-wrapper { gap: 100px; }
        .our-process-section .process-item.active .hexagon { transform: scale(1.30); }
    }
    @media (min-width: 768px) and (max-width:1200px) {
        .our-process-section .process-wrapper { gap: 80px; }
        .our-process-section .process-item.active .hexagon { transform: scale(1.30); }
        .our-process-section .process-item { width: 23.33%; }
        .our-process-section { padding: 60px 0 80px 0; }
    }

    @media(max-width:767px) {
        .our-process-section { padding: 43px 0 58px 0; min-height: 100svh; }
        .lab-test-download { margin-top: 30px; gap: 20px; }
        .our-process-section .title-blog { padding-bottom: 15px; max-width: 330px; margin: 0 auto; }
        .our-process-section .section-title { line-height: 1; margin: 0 0 5px 0; }
        .our-process-section .section-subtitle { margin: 0; }
        .our-process-section::after { content: ""; position: unset; }
        .our-process-section .process-wrapper { gap: 110px; flex-wrap: wrap; position: relative; }
        .our-process-section .hexagon { position: unset; overflow: visible; }
        .our-process-section .process-item.active .content-wrap { display: unset; }
        .our-process-section .process-item { cursor: pointer; width: 28.33%; flex-wrap: wrap; }
        .our-process-section .hex-title { color: #000; display: none; }
        .our-process-section .content-wrap { color: #000; display: none; }
        .our-process-section .process-content { position: unset; top: 0%; left: 0%; width: 100%; transform: unset; max-width: 100%; }
        .our-process-section .process-item.active .process-content { transform: unset; }
        .our-process-section .process-item.active .hexagon { transform: unset; }
        .our-process-section .hexagon img { max-width: 90px; min-height: 80px; }
        .our-process-section .process-item { width: 34%; flex-wrap: wrap; }
        .our-process-section .process-wrapper .process-item:first-child { width: 55%; }
        .our-process-section .process-item.active .content-wrap { display: none; }
        .our-process-section .process-content { display: none; }
        .our-process-section .hexagon { display: flex; justify-content: center; }
        .our-process-section .mobile-process-content { margin-top: 20px; text-align: center; display: block; }

        .our-process-section .mobile-hex-title-wrap {
            position: absolute;
            top: 54%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 112px;
            text-align: center;
            z-index: 2;
            pointer-events: none;
        }
        .our-process-section .mobile-hex-title-wrap .hex-title {
            font-size: 20px; line-height: 1; font-weight: 700; font-family: 'Aeonik';
            letter-spacing: 0; display: block; color: #000;
        }
        .our-process-section .mobile-process-content .hex-title {
            display: none;
        }
        .our-process-section .mobile-process-content .content-wrap {
            font-size: 16px; line-height: 1.25; display: block; position: relative;
            font-family: 'Aeonik'; letter-spacing: 0; margin: 0; color: #000; font-weight: 400;
        }

        /* Lines start hidden */
        .our-process-section .process-wrapper::before,
        .our-process-section .process-wrapper::after {
            opacity: 0;
        }

        .our-process-section .process-wrapper::before {
            content: ""; position: absolute; top: 63px; left: 123px;
            width: 70px; height: 122px; z-index: 1;
            background-image: url('https://cdn.shopify.com/s/files/1/0688/9612/9324/files/Vector_20.svg?v=1769597468');
            background-size: contain; background-repeat: no-repeat;
        }
        .our-process-section .process-wrapper::after {
            content: ""; position: absolute; top: 63px; right: 123px;
            width: 70px; height: 122px; z-index: 1;
            background-image: url('https://cdn.shopify.com/s/files/1/0688/9612/9324/files/Vector_21.svg?v=1769597870');
            background-size: contain; background-repeat: no-repeat;
        }

        /* Bottom connector line — hidden by default, shown via JS class */
        .our-process-section .mobile-process-content .content-wrap::before {
            content: ""; position: absolute; top: -61px; left: 50%;
            transform: translateX(-50%);
            width: 127px; height: 122px; z-index: 1;
            background-image: url('https://cdn.shopify.com/s/files/1/0688/9612/9324/files/Vector_22.svg?v=1769598072');
            background-size: contain; background-repeat: no-repeat;
            opacity: 0;
        }

        /* Hide bottom connector during early steps */
        .our-process-section .mobile-process-content.hide-connector .content-wrap::before {
            display: none !important;
        }

        .our-process-section .process-item { opacity: 1; }
        .our-process-section .process-item.active .hexagon { opacity: 1; }
        .our-process-section .process-item .hexagon { opacity: 0.5; transition: opacity 0.3s ease; }
    }

    /* ── Animations ── */
    @keyframes process-icon-in {
        from { opacity: 0.3; transform: scale(0.88); }
        to   { opacity: 1;   transform: scale(1); }
    }
    @keyframes process-title-up {
        from { opacity: 0; transform: translateY(12px); }
        to   { opacity: 1; transform: translateY(0); }
    }
    @keyframes process-content-out {
        from { opacity: 1; transform: translateY(0); }
        to   { opacity: 0; transform: translateY(-22px); }
    }
    @keyframes process-content-in {
        from { opacity: 0; transform: translateY(24px); }
        to   { opacity: 1; transform: translateY(0); }
    }
    @keyframes process-content-out-reverse {
        from { opacity: 1; transform: translateY(0); }
        to   { opacity: 0; transform: translateY(22px); }
    }
    @keyframes process-content-in-reverse {
        from { opacity: 0; transform: translateY(-24px); }
        to   { opacity: 1; transform: translateY(0); }
    }
    @keyframes process-header-up {
        from { opacity: 0; transform: translateY(30px); }
        to   { opacity: 1; transform: translateY(0); }
    }
    @keyframes process-line-v {
        from { clip-path: inset(0 0 100% 0); opacity: 0.3; }
        to   { clip-path: inset(0 0 0% 0);   opacity: 1; }
    }
    @keyframes process-line-h {
        from { clip-path: inset(0 50% 0 50%); opacity: 0.3; }
        to   { clip-path: inset(0 0% 0 0%);   opacity: 1; }
    }
@keyframes process-line-v-reverse {
  from { clip-path: inset(100% 0 0 0); opacity: 0.3; }
  to   { clip-path: inset(0 0 0 0);   opacity: 1; }
}

    @media (max-width: 767px) {
        /* Header fade-up */
        .our-process-section .title-blog {
            opacity: 0;
            transform: translateY(30px);
            transition: none;
        }
        .our-process-section .title-blog.header-visible {
            animation: process-header-up 0.85s cubic-bezier(0.22, 1, 0.36, 1) forwards;
        }
        /* Icon: fade-in */
        .our-process-section .process-item.just-activated .hexagon {
            animation: process-icon-in 0.55s cubic-bezier(0.22, 1, 0.36, 1) forwards;
        }
        /* Central title */
        .our-process-section .mobile-hex-title-wrap.title-animating .hex-title {
            animation: process-title-up 0.55s cubic-bezier(0.22, 1, 0.36, 1) forwards;
        }
        /* Description: exit up */
        .our-process-section .mobile-process-content.leaving {
            animation: process-content-out 0.32s cubic-bezier(0.4, 0, 0.8, 1) forwards;
        }
        /* Description: exit down */
        .our-process-section .mobile-process-content.leaving-reverse {
            animation: process-content-out-reverse 0.32s cubic-bezier(0.4, 0, 0.8, 1) forwards;
        }
        /* Description: enter from below */
        .our-process-section .mobile-process-content.animating {
            animation: process-content-in 0.58s cubic-bezier(0.22, 1, 0.36, 1) forwards;
        }
        /* Description: enter from above */
        .our-process-section .mobile-process-content.animating-reverse {
            animation: process-content-in-reverse 0.58s cubic-bezier(0.22, 1, 0.36, 1) forwards;
        }

        /* Individual line triggers */
        .our-process-section .process-wrapper.draw-line-right::after {
            animation: process-line-v 0.55s ease-out forwards;
        }
       .our-process-section .process-wrapper.draw-line-left::before {
    animation: process-line-v-reverse 0.55s ease-out forwards;
}

        .our-process-section .mobile-process-content.draw-line-bottom .content-wrap::before {
            animation: process-line-h 0.45s ease-out both;
        }
    }

    @media (max-width: 450px) {
        .our-process-section .process-wrapper::after {
            right: 73px!important;
        }
        .our-process-section .process-wrapper::before {
            left: 73px!important;
        }
    }

    @media(max-width:380px) {
        .our-process-section .process-item { width: 33%; }
        .our-process-section .process-wrapper::before { left: 54px; }
        .our-process-section .process-wrapper::after { right: 50px; }
    }
</style>

<section class="our-process-section">
  <div class="page-width">
    <div class="title-blog">
      {% if section.settings.heading != blank %}
        <h2 class="section-title">{{ section.settings.heading }}</h2>
      {% endif %}
      {% if section.settings.subheading != blank %}
        <div class="section-subtitle">{{ section.settings.subheading }}</div>
      {% endif %}
    </div>
    <div class="process-wrapper">
      {% for block in section.blocks %}
        <div class="process-item" data-index="{{ forloop.index }}">
          <div class="hexagon">
            {% if block.settings.image != blank %}
              <img
                src="{{ block.settings.image | image_url }}"
                alt="{{ block.settings.heading }}"
                width="{{ block.settings.image.width }}"
                height="{{ block.settings.image.height }}"
                loading="lazy"
              >
            {% endif %}
            <div class="process-content">
              {% if block.settings.title != blank %}
                <div class="hex-title body-font">{{ block.settings.title }}</div>
              {% endif %}
              {% if block.settings.content != blank %}
                <div class="content-wrap body-font">{{ block.settings.content }}</div>
              {% endif %}
            </div>
          </div>
        </div>
      {% endfor %}
    </div>
    <div class="mobile-hex-title-wrap"></div>
    <div class="mobile-process-content"></div>

    {%- liquid
      assign lab_test_url = product.metafields.custom.lab_test_results_url.value | default: product.metafields.custom.lab_test_results_url
      if product == blank
        assign lab_test_url = nil
      endif
    -%}
    {% if lab_test_url != blank %}
      <a
        href="{{ lab_test_url }}"
        download
        class="lab-test-download"
      >
        DOWNLOAD THE LAB TEST RESULTS
        <span class="download-icon"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
          <path d="M21 13.5V19.5C21 19.6989 20.921 19.8897 20.7803 20.0303C20.6397 20.171 20.4489 20.25 20.25 20.25H3.75C3.55109 20.25 3.36032 20.171 3.21967 20.0303C3.07902 19.8897 3 19.6989 3 19.5V13.5C3 13.3011 3.07902 13.1103 3.21967 12.9697C3.36032 12.829 3.55109 12.75 3.75 12.75C3.94891 12.75 4.13968 12.829 4.28033 12.9697C4.42098 13.1103 4.5 13.3011 4.5 13.5V18.75H19.5V13.5C19.5 13.3011 19.579 13.1103 19.7197 12.9697C19.8603 12.829 20.0511 12.75 20.25 12.75C20.4489 12.75 20.6397 12.829 20.7803 12.9697C20.921 13.1103 21 13.3011 21 13.5ZM11.4694 14.0306C11.539 14.1004 11.6217 14.1557 11.7128 14.1934C11.8038 14.2312 11.9014 14.2506 12 14.2506C12.0986 14.2506 12.1962 14.2312 12.2872 14.1934C12.3783 14.1557 12.461 14.1004 12.5306 14.0306L16.2806 10.2806C16.3503 10.2109 16.4056 10.1282 16.4433 10.0372C16.481 9.94613 16.5004 9.84855 16.5004 9.75C16.5004 9.65145 16.481 9.55387 16.4433 9.46283C16.4056 9.37178 16.3503 9.28906 16.2806 9.21937C16.2109 9.14969 16.1282 9.09442 16.0372 9.0567C15.9461 9.01899 15.8485 8.99958 15.75 8.99958C15.6515 8.99958 15.5539 9.01899 15.4628 9.0567C15.3718 9.09442 15.2891 9.14969 15.2194 9.21937L12.75 11.6897V3C12.75 2.80109 12.671 2.61032 12.5303 2.46967C12.3897 2.32902 12.1989 2.25 12 2.25C11.8011 2.25 11.6103 2.32902 11.4697 2.46967C11.329 2.61032 11.25 2.80109 11.25 3V11.6897L8.78063 9.21937C8.63989 9.07864 8.44902 8.99958 8.25 8.99958C8.05098 8.99958 7.86011 9.07864 7.71937 9.21937C7.57864 9.36011 7.49958 9.55098 7.49958 9.75C7.49958 9.94902 7.57864 10.1399 7.71937 10.2806L11.4694 14.0306Z" fill="black"/>
        </svg></span>
      </a>
    {% endif %}
  </div>
</section>

<script>
document.addEventListener('DOMContentLoaded', function () {
  var items = document.querySelectorAll('.process-item');
  var mobileContent = document.querySelector('.mobile-process-content');
  var mobileTitleWrap = document.querySelector('.mobile-hex-title-wrap');
  var processWrapper = document.querySelector('.process-wrapper');
  var titleBlog = document.querySelector('.our-process-section .title-blog');
  var section = document.querySelector('.our-process-section');
  var scrollOrder = [0, 2, 1]; // top → right → left
  var sequencePlayed = false;
  var sequenceTimers = [];

  /* ── Show a single item (mobile) ── */
  function showItem(stepIndex, animate) {
    var itemsArr = Array.from(items);
    var domIndex = scrollOrder[stepIndex];
    var item = itemsArr[domIndex];

    items.forEach(function (i) { i.classList.remove('active', 'just-activated'); });
    item.classList.add('active');
    if (animate) {
      void item.querySelector('.hexagon').offsetWidth;
      item.classList.add('just-activated');
    }

    var title = item.querySelector('.hex-title')?.innerHTML || '';
    if (mobileTitleWrap) {
      mobileTitleWrap.innerHTML = title ? '<div class="hex-title">' + title + '</div>' : '';
      if (animate) {
        mobileTitleWrap.classList.remove('title-animating');
        void mobileTitleWrap.offsetWidth;
        mobileTitleWrap.classList.add('title-animating');
      }
    }

    var content = item.querySelector('.content-wrap')?.innerHTML || '';
    if (content && mobileContent) {
      mobileContent.style.display = 'block';
      mobileContent.classList.remove('animating', 'animating-reverse', 'leaving', 'leaving-reverse');
      mobileContent.innerHTML = '<div class="content-wrap">' + content + '</div>';
      if (animate) {
        void mobileContent.offsetWidth;
        mobileContent.classList.add('animating');
      }
    }
  }

  /* ── Clear all pending timers ── */
  function clearTimers() {
    sequenceTimers.forEach(function (t) { clearTimeout(t); });
    sequenceTimers = [];
  }

  /* ── Sequential intro: top → right line → right → bottom line → left → left line ── */
  function runSequence() {
    if (sequencePlayed) return;
    sequencePlayed = true;
    clearTimers();

    // Step 1 (0ms): Top item activates
    mobileContent.classList.add('hide-connector');
    showItem(0, true);

    // Step 2 (800ms): Right diagonal line draws
    sequenceTimers.push(setTimeout(function () {
      processWrapper.classList.add('draw-line-right');
    }, 800));

    // Step 3 (1350ms): Right item activates
    sequenceTimers.push(setTimeout(function () {
      showItem(1, true);
    }, 1350));

    // Step 4 (2150ms): Bottom connector line draws + left item activates
    sequenceTimers.push(setTimeout(function () {
      mobileContent.classList.remove('hide-connector');
      mobileContent.classList.add('draw-line-bottom');
      showItem(2, true);
    }, 2150));

    // Step 5 (2700ms): Left diagonal line draws back to top — loop closes
    sequenceTimers.push(setTimeout(function () {
      processWrapper.classList.add('draw-line-left');
    }, 2700));
  }

  /* ── Reset everything for replay ── */
  function resetSequence() {
    clearTimers();
    sequencePlayed = false;
    items.forEach(function (i) { i.classList.remove('active', 'just-activated'); });
    if (processWrapper) {
      processWrapper.classList.remove('draw-line-right', 'draw-line-left');
    }
    if (mobileContent) {
      mobileContent.classList.remove('animating', 'animating-reverse', 'leaving', 'leaving-reverse', 'draw-line-bottom', 'hide-connector');
      mobileContent.innerHTML = '';
      mobileContent.style.display = '';
    }
    if (mobileTitleWrap) {
      mobileTitleWrap.innerHTML = '';
      mobileTitleWrap.classList.remove('title-animating');
    }
  }

  /* ── Desktop: hover / click ── */
  items.forEach(function (item) {
    item.addEventListener('mouseenter', function () {
      if (window.innerWidth <= 767) return;
      items.forEach(function (i) { i.classList.remove('active'); });
      item.classList.add('active');
    });
    item.addEventListener('click', function () {
      if (window.innerWidth <= 767) return;
      items.forEach(function (i) { i.classList.remove('active'); });
      item.classList.add('active');
    });
  });

  if (window.innerWidth > 767 && items.length) {
    items[0].classList.add('active');
  }

  /* ── Mobile: header observer ── */
  if (titleBlog) {
    var headerObs = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (window.innerWidth > 767) return;
        if (entry.isIntersecting) {
          titleBlog.classList.remove('header-visible');
          void titleBlog.offsetWidth;
          titleBlog.classList.add('header-visible');
        } else {
          titleBlog.classList.remove('header-visible');
        }
      });
    }, { threshold: 0.1 });
    headerObs.observe(titleBlog);
  }

  /* ── Mobile: play sequence on enter, reset on leave ── */
  if (section && window.innerWidth <= 767) {
    var sectionObs = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (entry.isIntersecting) {
          runSequence();
        } else {
          resetSequence();
        }
      });
    }, { threshold: 0.15 });
    sectionObs.observe(section);
  }
});
</script>

{% schema %}
{
  "name": "Our Process",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Select Background Color"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Add Heading"
    },
    {
      "type": "inline_richtext",
      "id": "subheading",
      "label": "Add Sub Text"
    }
  ],
  "blocks": [
    {
      "type": "process",
      "name": "Process Item",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "inline_richtext",
          "id": "title",
          "label": "Add Title"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Add Content"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Our Process"
    }
  ]
}
{% endschema %}
