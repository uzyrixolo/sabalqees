<section class="why-choose-sidr-honey-section" style="background: {{ section.settings.bg_color }}">
  <div class="page-width">
    <div class="why-choose-wrapper">
      <!-- LEFT CONTENT -->
      <div class="why-sidr-left">
        {% if section.settings.heading %}
          <h2>{{ section.settings.heading }}</h2>
        {% endif %}
        {% if section.settings.subheading %}
          <div class="sub-text body-font">{{ section.settings.subheading }}</div>
        {% endif %}

        <div class="btn-wrapper">
          {% if section.settings.btn_txt != blank %}
            <a
              class="dev-btn" data-add-btn
              href="{{ section.settings.btn_url }}"
              style=" background-color: {{ section.settings.btn_bg_color }}; color: {{ section.settings.btn_text_color }};"
            >
              {{ section.settings.btn_txt }}
            </a>
          {% endif %}
        </div>
      </div>
      <!-- RIGHT COMPARISON -->
      <div class="why-sidr-right">
        <!-- RAW SIDR -->
        <div class="compare-card-wrap left-blog">
          <div class="raw_image-wrap left-img">
            {% if section.settings.raw_image %}
              <img
                src="{{ section.settings.raw_image | image_url }}"
                alt="{{ section.settings.raw_image.alt | default: section.settings.raw_image | escape }}"
                loading="lazy"
                width="{{ section.settings.raw_image.width }}"
                height="{{ section.settings.raw_image.height }}"
              >
            {% endif %}
          </div>
          <div class="left-block">
            <div class="mobile-pro-image">
              {% if section.settings.raw_mobile_image %}
                <img
                  src="{{ section.settings.raw_mobile_image | image_url }}"
                  alt="{{ section.settings.raw_mobile_image.alt | default: section.settings.raw_mobile_image | escape }}"
                  loading="lazy"
                  width="{{ section.settings.raw_mobile_image.width }}"
                  height="{{ section.settings.raw_mobile_image.height }}"
                >
              {% endif %}
            </div>
            <div class="left-title body-font">{{ section.settings.raw_title }}</div>
            {% for block in section.blocks %}
              {% if block.type == 'left_point' %}
                <div class="svg-with-text">
                  <div class="check-svg">
                    {% if block.settings.check_svg != blank %}
                      <img
                        src="{{ block.settings.check_svg | image_url }}"
                        alt="{{ block.settings.check_svg.alt | default: block.settings.check_svg | escape }}"
                        loading="lazy"
                        width="{{ block.settings.check_svg.width }}"
                        height="{{ block.settings.check_svg.height }}"
                      >
                    {% endif %}
                  </div>
                  {% if block.settings.text != blank %}
                    <div class="left-desc body-font">{{ block.settings.text }}</div>
                  {% endif %}
                </div>
              {% endif %}
            {% endfor %}
          </div>
        </div>
        <!-- GENERIC -->
        <div class="compare-card-wrap right-blog">
          <div class="raw_image-wrap right-img">
            {% if section.settings.generic_image %}
              <img
                src="{{ section.settings.generic_image | image_url }}"
                alt="{{ section.settings.generic_image.alt | default: section.settings.generic_image | escape }}"
                loading="lazy"
                width="{{ section.settings.generic_image.width }}"
                height="{{ section.settings.generic_image.height }}"
              >
            {% endif %}
          </div>
          <div class="right-block">
            <div class="mobile-pro-image">
              {% if section.settings.generic_mobile_image %}
                <img
                  src="{{ section.settings.generic_mobile_image | image_url }}"
                  alt="{{ section.settings.generic_mobile_image.alt | default: section.settings.generic_mobile_image | escape }}"
                  loading="lazy"
                  width="{{ section.settings.generic_mobile_image.width }}"
                  height="{{ section.settings.generic_mobile_image.height }}"
                >
              {% endif %}
            </div>
            <div class="right-title body-font">{{ section.settings.generic_title }}</div>
            {% for block in section.blocks %}
              {% if block.type == 'right_point' %}
                <div class="svg-with-text">
                  <div class="cross-svg">
                    {% if block.settings.cross_svg != blank %}
                      <img
                        src="{{ block.settings.cross_svg | image_url }}"
                        alt="{{ block.settings.cross_svg.alt | default: block.settings.cross_svg | escape }}"
                        loading="lazy"
                        width="{{ block.settings.cross_svg.width }}"
                        height="{{ block.settings.cross_svg.height }}"
                      >
                    {% endif %}
                  </div>
                  {% if block.settings.text != blank %}
                    <div class="right-desc body-font">{{ block.settings.text }}</div>
                  {% endif %}
                </div>
              {% endif %}
            {% endfor %}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Why Choose Raw Sidr Honey",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "inline_richtext",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "text",
      "id": "btn_txt",
      "label": "Button Text"
    },
    {
      "type": "url",
      "id": "btn_url",
      "label": "Button Link"
    },
    {
      "type": "color",
      "id": "btn_bg_color",
      "label": "Button background color"
    },
    {
      "type": "color",
      "id": "btn_text_color",
      "label": "Button text color"
    },
    {
      "type": "image_picker",
      "id": "raw_image",
      "label": "Raw honey Desktop image"
    },

    {
      "type": "image_picker",
      "id": "raw_mobile_image",
      "label": "Raw honey image Mobile"
    },

    {
      "type": "inline_richtext",
      "id": "raw_title",
      "label": "Raw honey title"
