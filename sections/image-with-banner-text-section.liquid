<style>
.image-with-banner-section {
    position: relative;
    overflow: hidden;
}

.image-with-banner-section .background-image {
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    margin: 0;
    display: block;
    width: 100%;
    height: 100%;
}

.image-with-banner-section .review-text {
    font-size: 20px;
    letter-spacing: 0;
    line-height: 1.2;
    font-weight: 400;
    color: #000;
    text-align: center;
    margin: 0 0 14px 0;
}

.image-with-banner-section .btn-wrapper {
    display: flex;
    justify-content: center;
}

.image-with-banner-section .background-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    aspect-ratio: 2.48/1;
}

.image-with-banner-section .title-wrap {
    max-width: 863px;
    margin: 0 auto;
}

.image-with-banner-section .section-heading {
    margin: 0 0 20px 0;
    text-align: center;
}

.image-with-banner-section .btn-wrapper-mobile {
    display: none;
}

.image-with-banner-section .contain-wrapper {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 100%;
    max-width: 1070px;
    backdrop-filter: blur(10px);
     -webkit-backdrop-filter: blur(10px);
    background: #FFFFFF80;
    border-radius: 15px;
    padding: 35px 0 27px 0;
}

@media (min-width: 768px) and (max-width:1200px) {

    .image-with-banner-section .review-text {
        font-size: 16px;
    }

    .image-with-banner-section .contain-wrapper {
        max-width: 700px;
        padding: 25px 12px 20px 12px;
    }
}

@media only screen and (max-width:767px) {
    .image-with-banner-section .contain-wrapper {
        max-width: 358px;
        margin: 0 auto;
        padding: 29px 11px 20px 14px;
        top: 45%;
    }

    .image-with-banner-section .background-image img {
        aspect-ratio: 0.94/1;
    }

    .image-with-banner-section .review-text {
        font-size: 16px;
        margin: 0;
    }

    .image-with-banner-section .title-wrap {
        max-width: 100%;
    }

    .image-with-banner-section .section-heading {
        margin: 0 0 5px 0;
    }

    .image-with-banner-section .btn-wrapper-mobile {
        display: flex;
        max-width: 204px;
        margin: 0 auto;
        position: absolute;
        bottom: 40px;
        left: 24%;
    }

    .image-with-banner-section .btn-wrapper {
        display: none;
    }
}

@media only screen and (max-width:380px) {
    .image-with-banner-section .section-heading {
        font-size: 30px;
    }

    .image-with-banner-section .contain-wrapper {
        max-width: 336px;
    }
}
</style>
<section class="image-with-banner-section">
  <div class="background-image">
    {%- if section.settings.destop_img != blank -%}
      {%- liquid
        assign mobileImage = section.settings.destop_img
        if section.settings.mobile_img != blank
          assign mobileImage = section.settings.mobile_img
        endif
      -%}
      <picture>
        <source media="(min-width: 1901px)" srcset="{{ section.settings.destop_img | image_url: width: 2560 }}">
        <source media="(min-width: 1700px)" srcset="{{ section.settings.destop_img | image_url: width: 2020 }}">
        <source media="(min-width: 1500px)" srcset="{{ section.settings.destop_img | image_url: width: 1820 }}">
        <source media="(min-width: 1200px)" srcset="{{ section.settings.destop_img | image_url: width: 1600 }}">
        <source media="(min-width: 991px)" srcset="{{ section.settings.destop_img | image_url: width: 1350 }}">
        <source media="(min-width: 820px)" srcset="{{ section.settings.destop_img | image_url: width: 1200 }}">
        <source media="(min-width: 768px)" srcset="{{ mobileImage | image_url: width: 1100 }}">
        <source media="(min-width: 576px)" srcset="{{ mobileImage | image_url: width: 800 }}">
        <source media="(min-width: 400px)" srcset="{{ mobileImage | image_url: width: 700 }}">
        <source media="(min-width: 0)" srcset="{{ mobileImage | image_url: width: 600 }}">
        <source media="(min-width: 0)" srcset="{{ mobileImage | image_url: width: 400 }}">
        <img
          src="{{ section.settings.destop_img | image_url }}"
          alt="{{ section.settings.destop_img.alt | default: section.settings.heading | escape }}"
          width="{{ section.settings.destop_img.width }}"
          loading="lazy"
          height="{{ section.settings.destop_img.width | divided_by: section.settings.destop_img.aspect_ratio | round }}"
        >
      </picture>
    {%- endif -%}
  </div>
  <div class="contain-wrapper">
    <div class="title-wrap">
      {%- if section.settings.heading != blank -%}
        <h2 class="section-heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {% if section.settings.review_text != blank %}
        <div class="review-text body-font">{{ section.settings.review_text }}</div>
      {% endif %}
    </div>
    <div class="btn-wrapper">
      {% if section.settings.btn_txt != blank %}
        <a
          class="dev-btn"
          href="{{ section.settings.btn_url }}"
          style=" background-color: {{ section.settings.btn_bg_color }}; color: {{ section.settings.btn_text_color }};"
        >
          {{ section.settings.btn_txt }}
        </a>
      {% endif %}
    </div>
  </div>
  <div class="btn-wrapper-mobile">
    {% if section.settings.btn_txt != blank %}
      <a
        class="dev-btn"
        href="{{ section.settings.btn_url }}"
        style=" background-color: {{ section.settings.btn_bg_color }}; color: {{ section.settings.btn_text_color }};"
      >
        {{ section.settings.btn_txt }}
      </a>
    {% endif %}
  </div>
</section>
{% schema %}
{
  "name": "Image With Banner Text",
  "settings": [
    {
      "type": "header",
      "content": "Image With Banner"
    },
    {
      "type": "image_picker",
      "id": "destop_img",
      "label": "Destop Image"
    },
    {
      "type": "image_picker",
      "id": "mobile_img",
      "label": "Mobile Image"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Add Heading"
    },
    {
      "type": "inline_richtext",
      "id": "review_text",
      "label": "Add Text"
    },
    {
      "type": "text",
      "id": "btn_txt",
      "label": "Button Text"
    },
    {
      "type": "url",
      "id": "btn_url",
      "label": "Button Link"
    },
    {
      "type": "color",
      "id": "btn_bg_color",
      "label": "Button background color"
    },
    {
      "type": "color",
      "id": "btn_text_color",
      "label": "Button text color"
    }
  ],
  "presets": [
    {
      "name": "Image With Banner Text Section"
    }
  ]
}
{% endschema %}
