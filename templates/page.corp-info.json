            "title": "",
            "custom_html": "<div class=\"t4s-col-inner t4s-text-md-start t4s-text-start \" style=\"--pd: 0 0 0 0;--pd-mb: 0 0 0 0;\">\n                      \n                      <div class=\"t4s-footer-heading t4s-d-flex t4s-align-items-center t4s-justify-content-between t4s-d-md-block t4s-d-none\">\n                         \n                      </div>\n<div data-footer-open=\"\" class=\"t4s-footer-heading t4s-footer-heading-mobile t4s-d-flex t4s-align-items-center t4s-justify-content-between t4s-d-md-none\">\n                        \n                          <h3 class=\"t4s-col-heading t4s-fnt-fm-inherit\">HELP</h3>\n<span class=\"t4s-footer-collapse-icon\"></span>\n                      </div>\n<div data-footer-content=\"\" class=\"t4s-footer-content\">\n<div class=\"t4s-footer-menu t4s-footer-menu-style1\" style=\"--menu-mgb:px;--menu-mgb-mb:px;\">\n                            <ul class=\"t4s-footer-linklist\">\n<li>\n                                    <a href=\"/pages/frequently-asked-questions\" class=\"t4s-footer-link \">\n                                    FAQ\n                                    </a>\n                                </li>\n<li>\n                                    <a href=\"/pages/contact\" class=\"t4s-footer-link \">\n                                    CONTACT US\n                                    </a>\n                                </li>\n<li>\n                                    <a href=\"/account/login\" class=\"t4s-footer-link \">\n                                    MY PROFILE\n                                    </a>\n                                </li>\n<li>\n                                    <a href=\"/pages/privacy-policy\" class=\"t4s-footer-link \">\n                                    PRIVACY POLICY\n                                    </a>\n                                </li>\n<li>\n                                    <a href=\"/pages/delivery-information\" class=\"t4s-footer-link \">\n                                    DELIVERY INFORMATION\n                                    </a>\n                                </li>\n<li>\n                                    <a href=\"/pages/return-refund-policy\" class=\"t4s-footer-link \">\n                                    RETURNS &amp; REFUNDS\n                                    </a>\n                                </li>\n<li>\n                                    <a href=\"/pages/shopping-online\" class=\"t4s-footer-link \">\n                                    SHOPPING ONLINE\n                                    </a>\n                                </li>\n</ul>\n                            </div>\n</div>\n                </div>"
          }
