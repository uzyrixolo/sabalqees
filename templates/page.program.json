            "img_effect": "none",
            "b_effect": "none",
            "step_label": "2011",
            "sub_heading": "The first kiosk",
            "heading": "Dubai Mall",
            "description": "<p>We opened our first permanent kiosk in the famous Dubai Mall in 2011 introducing our taste and pour concept to the masses.</p>",
            "url": "",
            "btn_label": "Read more",
            "btn_icon": false,
