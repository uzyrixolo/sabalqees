          "type": "content",
          "settings": {
            "question_text": "<strong>What is \"Raw\" honey?</strong>",
            "answer": "<p>Raw honey is honey that has not been excessively heat treated or filtered. This ensures all of it's natural enzymes and beneficial compounds remain intact.</p>"
          }
        },
        "content_QcPKHX": {
          "type": "content",
          "settings": {
            "question_text": "<strong>Is it safe for daily use?</strong>",
            "answer": "<p>Yes, raw honey is packed with nutrients and antioxidants that support immune health and can be safely consumed daily.</p>"
          }
        },
        "content_CQ389y": {
          "type": "content",
          "settings": {
            "question_text": "<strong>Is it suitable for diabetics?</strong>",
            "answer": "<p>While raw honey can have a better glycaemic response than white sugar, we recommend speaking to a healthcare professional before consuming if you are diabetic.</p>"
          }
        }
      },
