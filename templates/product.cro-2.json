        "custom_liquid_BFEFp9": {
          "type": "custom_liquid",
          "disabled": true,
          "settings": {
            "custom_liquid": "<style>\n  /* 1. Main Wrapper with Bottom Border */\n  .collection-wrapper {\n    width: 100%;\n    padding-bottom: 40px;\n    margin-bottom: 40px;\n    border-bottom: 2px solid #000000;\n  }\n\n  /* 2. Heading: 32px and centered */\n  .collection-heading { \n    text-align: center; \n    font-size: 32px; \n    margin-bottom: 30px; \n    font-family: var(--font-heading-family); \n    color: #000;\n  }\n  \n  /* 3. Grid: Centered and stretched */\n  .collection-grid { \n    display: grid; \n    grid-template-columns: repeat(3, 1fr); \n    gap: 20px; \n    max-width: 1200px; \n    margin: 0 auto; \n    align-items: stretch; \n  }\n\n  /* 4. Cards: Perfectly centered text and vertical flex */\n  .collection-item { \n    background: #fff; \n    padding: 20px; \n    border-radius: 14px; \n    border: 1px solid #eee;\n    display: flex;              \n    flex-direction: column;    \n    text-align: center;        \n    align-items: center;       \n    height: 100%;              \n  }\n\n  /* NEW: Image Wrapper to contain the absolute badge */\n  .collection-image-wrapper {\n    position: relative;\n    width: 100%;\n    max-width: 180px; /* Controls image + badge container size */\n    margin: 0 auto 15px auto;\n  }\n\n  /* DECREASED IMAGE SIZE & CENTERED */\n  .collection-image-wrapper img.main-product-img { \n    width: 100%; \n    height: auto; \n    object-fit: contain;\n    display: block;\n  }\n\n  /* NEW: Badge specific to this block */\n  .collection-item-badge {\n    position: absolute;\n    top: 5px;\n    right: 5px;\n    z-index: 10;\n    pointer-events: none;\n  }\n\n  .collection-item-badge img {\n    max-width: 40px !important; /* Small size for the card */\n    height: auto !important;\n    display: block;\n    margin: 0 !important;\n  }\n\n  /* 5. Button & Price alignment */\n  .add-to-bag-wrapper {\n    margin-top: auto; \n    padding-top: 20px;\n    width: 100%;\n  }\n\n  .item-title { font-size: 12px; font-weight: bold; color: #000; margin: 10px 0; }\n  .item-desc { font-size: 12px; font-weight: 400; color: #000; margin-bottom: 10px; }\n  .item-price { font-size: 12px; font-weight: bold; color: #000; margin-bottom: 10px; }\n\n  .add-to-bag-btn {\n    background-color: #D29B74;\n    color: #000;\n    padding: 10px 20px;\n    border-radius: 25px;\n    text-decoration: none;\n    display: block; \n    text-align: center;\n    font-size: 12px;\n    font-weight: bold;\n    text-transform: uppercase;\n    width: 100%;\n    box-sizing: border-box;\n  }\n\n  /* Responsive for mobile - CSS Scroll Snap Carousel */\n  @media (max-width: 768px) {\n    .collection-grid { \n      display: flex; \n      flex-wrap: nowrap; \n      overflow-x: auto; \n      scroll-snap-type: x mandatory; \n      -webkit-overflow-scrolling: touch; /* Enables native swipe momentum */\n      padding-bottom: 15px; \n      scrollbar-width: none; \n      scroll-behavior: smooth;\n    }\n    \n    .collection-grid::-webkit-scrollbar {\n      display: none; \n    }\n\n    .collection-item { \n      flex: 0 0 80%; \n      scroll-snap-align: center; \n    }\n  }\n</style>\n\n{%- assign collection_products = product.metafields.custom.complete_collection.value -%}\n\n{%- if collection_products != blank -%}\n  <div class=\"collection-wrapper\">\n    <div class=\"collection-grid-section\">\n      <h2 class=\"collection-heading\">Complete your collection</h2>\n      <div class=\"collection-grid\" id=\"mobile-carousel\">\n        {% for item in collection_products %}\n          <div class=\"collection-item\">\n            \n            <div class=\"collection-image-wrapper\">\n              <img class=\"main-product-img\" src=\"{{ item.featured_image | image_url: width: 300 }}\" alt=\"{{ item.title }}\">\n              \n              {%- comment -%} CUSTOM PRODUCT BADGE START {%- endcomment -%}\n              {%- if item.metafields.custom.product_badge != blank -%}\n                <div class=\"collection-item-badge\">\n                  <img src=\"{{ item.metafields.custom.product_badge | image_url: width: 100 }}\" alt=\"Product Badge\" loading=\"lazy\">\n                </div>\n              {%- endif -%}\n              {%- comment -%} CUSTOM PRODUCT BADGE END {%- endcomment -%}\n            </div>\n\n            <div class=\"item-title\">{{ item.title }}</div>\n            <div class=\"item-desc\">{{ item.description | strip_html | truncatewords: 8 }}</div>\n            <div class=\"item-price\">{{ item.price | money }}</div>\n            \n            <div class=\"add-to-bag-wrapper\">\n              <a href=\"{{ item.url }}\" class=\"add-to-bag-btn\">ADD TO BAG</a>\n            </div>\n          </div>\n        {% endfor %}\n      </div>\n    </div>\n  </div>\n\n  <script>\n    document.addEventListener(\"DOMContentLoaded\", function() {\n      const carousel = document.getElementById('mobile-carousel');\n      let autoplayInterval;\n\n      function startAutoplay() {\n        // Only run autoplay on mobile screens where the carousel is active\n        if (window.innerWidth <= 768) {\n          autoplayInterval = setInterval(() => {\n            const firstItem = carousel.querySelector('.collection-item');\n            if (!firstItem) return;\n            \n            const itemWidth = firstItem.offsetWidth + 20; // Card width + grid gap\n            \n            // Check if we've reached the end of the scroll\n            if (carousel.scrollLeft + carousel.clientWidth >= carousel.scrollWidth - 10) {\n              carousel.scrollTo({ left: 0, behavior: 'smooth' }); // Loop back to start\n            } else {\n              carousel.scrollBy({ left: itemWidth, behavior: 'smooth' }); // Scroll to next item\n            }\n          }, 3000); // Change slide every 3 seconds\n        }\n      }\n\n      function stopAutoplay() {\n        clearInterval(autoplayInterval);\n      }\n\n      // Initialize Autoplay\n      startAutoplay();\n\n      // Pause the autoplay when the user interacts/swipes\n      carousel.addEventListener('touchstart', stopAutoplay, { passive: true });\n      carousel.addEventListener('touchend', startAutoplay, { passive: true });\n      carousel.addEventListener('mouseenter', stopAutoplay);\n      carousel.addEventListener('mouseleave', startAutoplay);\n\n      // Re-evaluate if window is resized (e.g., rotating phone)\n      window.addEventListener('resize', () => {\n        stopAutoplay();\n        startAutoplay();\n      });\n    });\n  </script>\n{%- endif -%}"
          }
        },
