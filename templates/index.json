    "e713475a-1c6d-4256-bd6e-8e24c076f9bb": {
      "type": "about_us",
      "blocks": {
        "template--19572417069356__e713475a-1c6d-4256-bd6e-8e24c076f9bb-bl_text-1": {
          "type": "bl_text",
          "settings": {
            "text": "<p>بلقيس متجر للعسل الخام أصبح من أشهر مورّدي العسل الخام الفاخر في الشرق الأوسط. وبفضل شغفنا بالمنتج ونجاحنا المثبت، وسّعنا اليوم تشكيلتنا في المملكة المتحدة وحول العالم. </p><p>نتعاون مع نحّالين مستقلين وجمعيات تعاونية لتربية النحل حول العالم يتبعون ممارسات مستدامة وأخلاقية. ومع كل عملية شراء، تساهم في دعم النحّالين وأسرهم في المجتمعات الريفية محليًا ودوليًا.</p><p>كل عسلنا الخام يأتي مباشرة من الخلية. نحن لا نعالجه حراريًا ولا نرشّحه ترشيحًا دقيقًا، ولا يُطعم أي من نحّالينا النحل محاليل سكرية أو مكملات. نحن ملتزمون بتوفير أنقى وأكثر أنواع العسل الخام طبيعية على وجه الأرض. </p>",
            "mgb": 25,
            "mgb_mb": 10
          }
        },
        "template--19572417069356__e713475a-1c6d-4256-bd6e-8e24c076f9bb-bl_image-1": {
