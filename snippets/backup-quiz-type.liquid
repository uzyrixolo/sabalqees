    <script>
(function(){
    const $slides = $('[data-slide]')
    const $slidesArray = $slides.toArray()
    const $slidesToggleUpButton = $('[data-slide-toggle="up"]')
    const $slidesToggleDownButton = $('[data-slide-toggle="down"]')
    const $progressBar = $('#progressBar') // Add reference to progress bar

    function ifAllItemsTrue(arr) {
        return arr.every(element => element === true);
    }

    function slidePositionSet(){
        let $activeSlide = $('[data-slide].active').get(0)
        let $activeSlideIndex = $slidesArray.indexOf($activeSlide)

        let prevPosition
        let nextPosition

        if($activeSlideIndex == 0){
            prevPosition = $slidesArray[0];
        }else{
            prevPosition = $slidesArray[$activeSlideIndex - 1];
        }
    
        if($activeSlideIndex == $slidesArray.length - 1){
            nextPosition = $slidesArray[$slidesArray.length - 1];
        }else{
            nextPosition = $slidesArray[$activeSlideIndex + 1];
        }
    
        return[prevPosition, nextPosition];
    }

    function slidePositionUpdate(){
        let $activeSlide = $('[data-slide].active').get(0)
        let $activeSlideIndex = $slidesArray.indexOf($activeSlide)

        $slidesArray.map(function(eachItem, eachIndex){
            if(eachIndex === $activeSlideIndex){
                $(eachItem).addClass('active')
                $(eachItem).css('--slide-index', 0)
                $(eachItem).attr('tabindex', 0)
            } else if(eachIndex > $activeSlideIndex){
                $(eachItem).removeClass('active')
                $(eachItem).css('--slide-index', 1)
                $(eachItem).attr('tabindex', -1)
            } else {
                $(eachItem).removeClass('active')
                $(eachItem).css('--slide-index', -1)
                $(eachItem).attr('tabindex', -1)
            }
        })

        updateProgressBar($activeSlideIndex) // Update the progress bar

        if($activeSlideIndex == 0){
            $slidesToggleUpButton.prop('disabled', true)
            $progressBar.hide(); // Hide progress bar on the first slide
        } else {
            $slidesToggleUpButton.removeAttr('disabled')
            $progressBar.show(); // Show progress bar on the second slide and beyond
        }

        checkCurrentFormFieldsValidOrNotOnInput()
        updateTextareaHeight()
    }

    function updateProgressBar(currentIndex) {
        let totalSlides = $slidesArray.length

        // Only start progress from the second slide
        if (currentIndex > 0) {
            let progressPercent = (currentIndex / (totalSlides - 1)) * 100
            $progressBar.css('width', progressPercent + '%')
        } else {
            $progressBar.css('width', '0%') // Reset the progress if on the first slide
        }
    }

    function calculateVerticalHeight(){
        var vh = window.innerHeight * 0.01
        document.documentElement.style.setProperty('--vh', vh + 'px')
    }

    function checkCurrentFormFieldsValidOrNot(){
        let $currentSlidesInnerFields = $('[data-slide].active [data-form="inner"] [data-form-inner="input"]')
        let currentSlidesInnerFieldsArray = []
        let $currentSlidesInnerFieldsRequired = $('[data-slide].active [data-option-group]')
        $currentSlidesInnerFields.each(function(inputsIndex, inputsItem){
            if(inputsItem.type == 'checkbox'){
                if(typeof $currentSlidesInnerFieldsRequired.data('input-required') !== 'undefined'){
                    const currentTotalChecked = $('[data-slide].active [data-form="inner"] [data-form-inner="input"]:checked')
                    if(currentTotalChecked.length === 0) {
                        currentSlidesInnerFieldsArray.push(false)
                    }else{
                        currentSlidesInnerFieldsArray.push(true)
                    }
                }else{
                    currentSlidesInnerFieldsArray.push(true)
                }
            }else{
                currentSlidesInnerFieldsArray.push(inputsItem.checkValidity())
            }
        })

        if(ifAllItemsTrue(currentSlidesInnerFieldsArray)){
            $slidesToggleDownButton.removeAttr('disabled')
        }else{
            $slidesToggleDownButton.prop('disabled', true)
        }
    }

    function checkCurrentFormFieldsValidOrNotOnInput(){
        let $currentSlidesInnerFields = $('[data-slide].active [data-form="inner"] [data-form-inner="input"]')
        $currentSlidesInnerFields.on('input', function(){
            checkCurrentFormFieldsValidOrNot()
        })
    }

    function updateTextareaHeight(){
        $('[data-slide].active [data-form="inner"] textarea[data-form-inner="input"]').on('input', function(){
            $(this).css('height', 'auto')
            $(this).css('height', $(this).get(0).scrollHeight + 0.5 + 'px')
        })
    }

    $(window).on('resize', function(){
        calculateVerticalHeight();
    })

    $(document).ready(function () {
        calculateVerticalHeight()
        slidePositionUpdate()
        checkCurrentFormFieldsValidOrNot()

        $slidesToggleUpButton.on("click", function(){
            let $activeSlide = $('[data-slide].active')
            let [prevPosition, nextPosition] = slidePositionSet()
            $activeSlide.removeClass("active")
            $(prevPosition).addClass("active")
            slidePositionUpdate()
            checkCurrentFormFieldsValidOrNot()
        })

        $slidesToggleDownButton.on("click", function(){
            let $activeSlide = $('[data-slide].active')
            let [prevPosition, nextPosition] = slidePositionSet()
            $activeSlide.removeClass("active")
            $(nextPosition).addClass("active")
            slidePositionUpdate()
            checkCurrentFormFieldsValidOrNot()
        })

        $('[data-form-inner="input"]:not(textarea)').each(function(){
            $(this).on('keydown', function(event){
                if (event.key === 'Enter') {
                    return false
                }
            })
        })
    });
  
})()
    </script>

<script>
document.addEventListener("DOMContentLoaded", function() {
    const checkboxes = document.querySelectorAll('input[name="q2"]');

    function handleSingleSelection(event) {
        // Uncheck all checkboxes except the currently clicked one
        checkboxes.forEach(checkbox => {
            if (checkbox !== event.target) {
                checkbox.checked = false;
            }
        });

        // Re-enable all checkboxes and reset opacity
        checkboxes.forEach(checkbox => {
            checkbox.disabled = false;
            checkbox.closest('label').style.opacity = '1';
        });

        // Disable unchecked checkboxes and lower opacity if the current one is checked
        if (event.target.checked) {
            checkboxes.forEach(checkbox => {
                if (!checkbox.checked) {
                    checkbox.disabled = true;
                    checkbox.closest('label').style.opacity = '0.5';
                }
            });
        }
    }

    // Attach the event listener to each checkbox
    checkboxes.forEach(checkbox => {
        checkbox.addEventListener('change', handleSingleSelection);
    });
});
</script>

<script>
document.addEventListener("DOMContentLoaded", async function() {
    // Load JSON mapping file from Shopify
    let quizMapping;
    try {
        const response = await fetch('{{ "honey_quiz_mapping.json" | asset_url }}');
        quizMapping = await response.json();
    } catch (error) {
        console.error("Failed to load quiz mapping:", error);
        return;
    }

    // Handle quiz step navigation
    document.querySelectorAll(".next-step").forEach(button => {
        button.addEventListener("click", () => {
            const currentStep = button.closest(".quiz-step");
            const nextStep = currentStep.nextElementSibling;

            currentStep.classList.remove("active");
            nextStep.classList.add("active");
        });
    });

    // Handle quiz form submission
    const honeyQuizForm = document.getElementById("honeyQuiz");
    const returnToInput = document.getElementById("returnTo");

    // Function to determine best collection based on quiz answers using JSON mapping
    function calculateBestCollection() {
        // Retrieve quiz answers
        const consumptionPreference = document.querySelector('input[name="q1"]:checked').value;
        const benefitPreferences = Array.from(document.querySelectorAll('input[name="q2"]:checked'))
                                       .map(el => el.value)
                                       .join("/");
        const flavorPreference = document.querySelector('input[name="q3"]:checked').value;

        // Generate the combination key
        const combinationKey = `${consumptionPreference} -> ${benefitPreferences} -> ${flavorPreference}`;

        // Lookup the best collection from the loaded quiz mapping
        const bestCollection = quizMapping[combinationKey] || "default-collection";

        // Set the best collection in the hidden input (for customer tag)
        document.querySelector("#CustomerNote").value = bestCollection;

        // Set the return_to URL based on the calculated collection
        returnToInput.value = `/collections/quiz-${bestCollection.toLowerCase().replace(/ /g, "-")}`;

        console.log("Best Collection: ", bestCollection);
        console.log("Redirecting to: ", returnToInput.value);

        return bestCollection;
    }

    // Listen for form submission event
    honeyQuizForm.addEventListener("submit", function(event) {
        const emailInput = document.getElementById('email').value;

        if (!emailInput) {
            // Email not provided, handle the flow without email
            event.preventDefault();
            calculateBestCollection();
            window.location.href = returnToInput.value; // Redirect to recommendations
        } else {
            // Email provided, continue with form submission
            calculateBestCollection(); // Calculate and set the return_to URL
        }
    });
});
</script>



<script>

(function() {
    const $slidesToggleDownButton = $('[data-slide-toggle="down"]'); // Reference to next button

    function checkCurrentFormFieldsValidOrNot() {
        let $currentSlide = $('[data-slide].active');
        let $currentSlideRequiredInputs = $currentSlide.find('[data-form-inner="input"]');
        let allFieldsValid = true;

        // Iterate over required inputs and check if they are valid
        $currentSlideRequiredInputs.each(function() {
            const $input = $(this);

            if ($input.attr('type') === 'radio' || $input.attr('type') === 'checkbox') {
                // For radio buttons and checkboxes, check if any option is selected
                if ($currentSlide.find(`input[name="${$input.attr('name')}"]:checked`).length === 0) {
                    allFieldsValid = false;
                }
            } else if (!$input.val()) {
                // For text inputs, check if the input is filled
                allFieldsValid = false;
            }
        });

        // If all fields are valid, enable the next button; otherwise, disable it
        if (allFieldsValid) {
            $slidesToggleDownButton.removeAttr('disabled').css('opacity', '1');
        } else {
            $slidesToggleDownButton.attr('disabled', true).css('opacity', '0.5');
        }
    }

    function checkCurrentFormFieldsValidOrNotOnInput() {
        // Monitor changes in form fields to re-check validity
        let $currentSlide = $('[data-slide].active');
        $currentSlide.on('input change', '[data-form-inner="input"]', function() {
            checkCurrentFormFieldsValidOrNot();
        });
    }

    $(document).ready(function() {
        // Initialize the form validation on load and whenever slide changes
        checkCurrentFormFieldsValidOrNot();
        checkCurrentFormFieldsValidOrNotOnInput();

        // Update the form validation each time the slide changes
        $('[data-slide-toggle="down"], [data-slide-toggle="up"]').on('click', function() {
            setTimeout(function() {
                checkCurrentFormFieldsValidOrNot();
                checkCurrentFormFieldsValidOrNotOnInput();
            }, 100); // Add slight delay to ensure slide change completes
        });
    });
})();
</script>

